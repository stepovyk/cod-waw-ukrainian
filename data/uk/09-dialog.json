 "SUBTITLE_PEL2_IGD_512A_ROEB": "^1РОБАК: ^7Зараз рвоне!",
 "SUBTITLE_PEL2_IGD_513A_ROEB": "^1РОБАК: ^7Забирайтеся звідти!",
 "SUBTITLE_PEL2_IGD_800A_USR1": "^1МОРПІХ: ^7Міллере, знайди базуку!",
 "SUBTITLE_PEL2_IGD_801A_USR1": "^1МОРПІХ: ^7Візьми базуку в окопах!",
 "SUBTITLE_PEL2_IGD_802A_USR1": "^1МОРПІХ: ^7Бий танки з базуки!",
 "SUBTITLE_PEL2_IGD_803A_USR1": "^1МОРПІХ: ^7Ну ж бо... бий танки з базуки!",
 "SUBTITLE_PEL2_OUT_000A_ROOK": "^1МОРПІХ: ^7Підтверджую, сер.\nЗенітки знищено.\nНебо чисте аж до хребта Кривавий Ніс.",
 "SUBTITLE_PEL2_OUT_001A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7От лайно... Сержанте, у нас проблема.",
