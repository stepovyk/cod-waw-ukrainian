 "SUBTITLE_PEL2_IGD_505A_ROEB": "^1РОБАК: ^7Нас оточили!",
 "SUBTITLE_PEL2_IGD_506A_POLO": "^1ПОЛОНСЬКИЙ: ^7Це була пастка!",
 "SUBTITLE_PEL2_IGD_507A_POLO": "^1ПОЛОНСЬКИЙ: ^7Вони всюди!",
 "SUBTITLE_PEL2_IGD_508A_ROEB": "^1РОБАК: ^7Не підпускайте їх!",
