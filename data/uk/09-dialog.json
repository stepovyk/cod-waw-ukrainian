{
 "SUBTITLE_PEL2_IGD_303A_ROEB": "^1РОБАК: ^7Отже, піднажмімо й знищимо\nці кляті гармати.",
 "SUBTITLE_PEL2_IGD_303A_ROEB_SAFE": "^1РОБАК: ^7Отже, піднажмімо й знищимо\nці гармати.",
