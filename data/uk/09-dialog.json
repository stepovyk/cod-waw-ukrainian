 "SUBTITLE_PEL2_OUT_005A_ROEB_A": "^1РОБАК: ^7Усім зайняти позиції. Дивитися вперед.",
 "SUBTITLE_PEL2_OUT_006B_ROEB": "^1РОБАК: ^7Тримайтеся.\nАеродром ми не віддамо!",
 "SUBTITLE_PEL2_OUT_007A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Трясця... його матері...",
 "SUBTITLE_PEL2_OUT_007A_POLO_SAFE": "^1ПОЛОНСЬКИЙ: ^7Боже мій...",
 "SUBTITLE_PEL2_OUT_008A_ROOK": "^1МОРПІХ: ^7Так, сер. Аеродром утримано...\nПовторюю, аеродром утримано.",
 "SUBTITLE_PEL2_OUT_200A_POLO": "^1ПОЛОНСЬКИЙ: ^7Ще підкріплення!",
 "SUBTITLE_PEL2_OUT_201A_ROEB": "^1РОБАК: ^7Вони займають позиції на тій вежі!",
 "SUBTITLE_PEL2_OUT_202A_ROEB": "^1РОБАК: ^7Вогонь по вежі!",
 "SUBTITLE_PEL2_OUT_203A_POLO": "^1ПОЛОНСЬКИЙ: ^7Вони підтягують танки!",
 "SUBTITLE_PEL2_OUT_204A_ROEB": "^1РОБАК: ^7На вантажівках ще піхота!!",
 "SUBTITLE_PEL2_OUT_205A_POLO": "^1ПОЛОНСЬКИЙ: ^7Звідки в біса взялося\nстільки підкріплення?!!!",
 "SUBTITLE_PEL2_OUT_206A_ROEB": "^1РОБАК: ^7Не припиняйте вогонь!!!",
 "SUBTITLE_PEL2_OUT_207A_POLO": "^1ПОЛОНСЬКИЙ: ^7Та це ціла клята колона!",
 "SUBTITLE_ROE_ORDER_MOVE_FORWARD_04": "^1РОБАК: ^7Спокійно, просуваємося вперед!",
 "SUBTITLE_RU_0_ORDER_ACTION_SUPPRESS_04": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Усі разом, товариші!",
 "SUBTITLE_RU_0_ORDER_ATTACK_INFANTRY_04": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Ось наш шанс! В атаку!",
 "SUBTITLE_RU_0_ORDER_ATTACK_INFANTRY_07": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Тепер нас не зупинити!",
 "SUBTITLE_RU_0_ORDER_ATTACK_INFANTRY_08": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Перемога близько!",
 "SUBTITLE_RU_0_ORDER_MOVE_FORWARD_05": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Швидше! Уперед!",
 "SUBTITLE_RU_1_ORDER_ACTION_BOOST_07": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Їхня оборона не встоїть!",
 "SUBTITLE_RU_1_ORDER_ACTION_BOOST_08": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Це наш шанс!",
 "SUBTITLE_RU_1_ORDER_ATTACK_INFANTRY_05": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Вони тікають!",
 "SUBTITLE_RU_1_THREAT_INFANTRY_MULTIPLE_03": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Ще фашисти!",
 "SUBTITLE_RU_2_ORDER_ACTION_SUPPRESS_08": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Треба більше вогню!",
 "SUBTITLE_RU_2_ORDER_MOVE_FORWARD_00": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Уперед!",
 "SUBTITLE_RU_2_RESPONSE_ACK_COVERING_05": "^1РЕЗНОВ: ^7Прикриваю!",
 "SUBTITLE_RU_CHE_INFORM_RELOADING_GENERIC_00": "^1ЧЕРНОВ: ^7Перезаряджаю!",
 "SUBTITLE_RU_REZ_INFORM_SUPPRESSED_GENERIC_04": "^1РЕЗНОВ: ^7Більше людей на передову!",
 "SUBTITLE_RU_REZ_LANDMARK_NEAR_BALCONY_00": "^1РЕЗНОВ: ^7На балконі!",
 "SUBTITLE_RU_REZ_LANDMARK_NEAR_BALCONY_01": "^1РЕЗНОВ: ^7Он там, на балконі!",
 "SUBTITLE_RU_REZ_LANDMARK_NEAR_EAGLE_00": "^1РЕЗНОВ: ^7Біля орла!",
 "SUBTITLE_RU_REZ_ORDER_ACTION_BOOST_02": "^1РЕЗНОВ: ^7Зітріть їх на порох!",
 "SUBTITLE_RU_REZ_ORDER_ACTION_BOOST_06": "^1РЕЗНОВ: ^7Знищте їх!",
 "SUBTITLE_RU_REZ_ORDER_ACTION_BOOST_08": "^1РЕЗНОВ: ^7Нікого не жаліти!",
 "SUBTITLE_RU_REZ_ORDER_ATTACK_INFANTRY_07": "^1РЕЗНОВ: ^7Треба наступати!",
 "SUBTITLE_RU_REZ_ORDER_ATTACK_INFANTRY_11": "^1РЕЗНОВ: ^7Відкиньте їх!",
 "SUBTITLE_RU_REZ_ORDER_MOVE_FOLLOW_00": "^1РЕЗНОВ: ^7За мною, швидко!",
 "SUBTITLE_RU_REZ_ORDER_MOVE_FOLLOW_01": "^1РЕЗНОВ: ^7Зі мною!",
 "SUBTITLE_RU_REZ_ORDER_MOVE_FORWARD_00": "^1РЕЗНОВ: ^7Уперед, хлопці!",
 "SUBTITLE_RU_REZ_ORDER_MOVE_FORWARD_04": "^1РЕЗНОВ: ^7Рухайтеся вперед!",
 "SUBTITLE_RU_REZ_THREAT_INFANTRY_EXPOSED_04": "^1РЕЗНОВ: ^7Стріляйте!",
 "SUBTITLE_RU_REZ_THREAT_INFANTRY_EXPOSED_08": "^1РЕЗНОВ: ^7Убийте їх усіх!",
 "SUBTITLE_RU_REZ_THREAT_INFANTRY_EXPOSED_10": "^1РЕЗНОВ: ^7Ось заради чого ви сюди прийшли!",
 "SUBTITLE_RU_REZ_THREAT_INFANTRY_MULTIPLE_02": "^1РЕЗНОВ: ^7Німецьке підкріплення!",
 "SUBTITLE_SEE1_IGD_000A_REZN": "^1РЕЗНОВ: ^7Бачиш, як усе змінилося, друже мій?",
 "SUBTITLE_SEE1_IGD_001A_REZN": "^1РЕЗНОВ: ^7Тепер це їхня земля... Їхній народ...\nЇхня кров.",
 "SUBTITLE_SEE1_IGD_002A_CHER": "^1ЧЕРНОВ: ^7Сержанте! Вони відступають!",
 "SUBTITLE_SEE1_IGD_003A_REZN_A": "^1РЕЗНОВ: ^7Так, Чернове... Але це їх не врятує.",
 "SUBTITLE_SEE1_IGD_004A_REZN": "^1РЕЗНОВ: ^7Утекти не вдасться нікому!",
 "SUBTITLE_SEE1_IGD_005A_REZN_A": "^1РЕЗНОВ: ^7Паліть пшеничні поля!",
 "SUBTITLE_SEE1_IGD_006A_REZN_B": "^1РЕЗНОВ: ^7Стріляйте!",
 "SUBTITLE_SEE1_IGD_007A_CHER": "^1ЧЕРНОВ: ^7Ми що, стрілятимемо їм у спину?",
 "SUBTITLE_SEE1_IGD_008A_REZN_A": "^1РЕЗНОВ: ^7У спину. У груди. У голову!...\nКуди завгодно! Аби тільки вони здохли!",
 "SUBTITLE_SEE1_IGD_009A_REZN_A": "^1РЕЗНОВ: ^7Цькуйте їх, як щурів, - бо вони щури і є.",
 "SUBTITLE_SEE1_IGD_010A_REZN": "^1РЕЗНОВ: ^7Влаштуйте їм пекло!!!",
 "SUBTITLE_SEE1_IGD_010A_REZN_SAFE": "^1РЕЗНОВ: ^7Убийте їх усіх!!",
 "SUBTITLE_SEE1_IGD_011A_REZN_A": "^1РЕЗНОВ: ^7У річку їх!",
 "SUBTITLE_SEE1_IGD_012A_REZN_A": "^1РЕЗНОВ: ^7Після Сталінграда я знаю: твоєму\nчуттю можна вірити, Дмитре.",
 "SUBTITLE_SEE1_IGD_013A_REZN_B": "^1РЕЗНОВ: ^7Ліворуч чи праворуч?... Веди ти.",
 "SUBTITLE_SEE1_IGD_014A_REZN_A": "^1РЕЗНОВ: ^7Женіть їх у ліс!",
 "SUBTITLE_SEE1_IGD_015A_REZN_A": "^1РЕЗНОВ: ^7Хай їхня палаюча країна стане останнім,\nщо вони побачать!",
 "SUBTITLE_SEE1_IGD_016A_REZN_B": "^1РЕЗНОВ: ^7Убийте їх усіх!",
 "SUBTITLE_SEE1_IGD_017A_REZN_A": "^1РЕЗНОВ: ^7Розчистіть шлях нашим танкам!",
 "SUBTITLE_SEE1_IGD_018A_REZN_A": "^1РЕЗНОВ: ^7Німецький кулемет просто під нами.",
 "SUBTITLE_SEE1_IGD_019A_REZN_A": "^1РЕЗНОВ: ^7Кидай коктейлі Молотова.\nХай згорять на своїх позиціях.",
 "SUBTITLE_SEE1_IGD_019B_REZN": "^1РЕЗНОВ: ^7Пусти в хід коктейлі Молотова.\nХай згорять на своїх позиціях.",
 "SUBTITLE_SEE1_IGD_020A_REZN_A": "^1РЕЗНОВ: ^7Відкиньте їх!",
 "SUBTITLE_SEE1_IGD_021A_REZN_A": "^1РЕЗНОВ: ^7Ці окопи стануть їм могилами!",
 "SUBTITLE_SEE1_IGD_022A_REZN": "^1РЕЗНОВ: ^7Наші танки виходять на поля!",
 "SUBTITLE_SEE1_IGD_024A_REZN": "^1РЕЗНОВ: ^7PANZERSCHRECK!!!",
 "SUBTITLE_SEE1_IGD_025A_REZN_A": "^1РЕЗНОВ: ^7Он там!... На балконі!",
 "SUBTITLE_SEE1_IGD_026A_REZN_A": "^1РЕЗНОВ: ^7ВПЕРЕД!!!",
 "SUBTITLE_SEE1_IGD_027A_REZN_A": "^1РЕЗНОВ: ^7Дмитре! Веди в атаку!",
 "SUBTITLE_SEE1_IGD_028A_REZN_A": "^1РЕЗНОВ: ^7Захистіть наші танки!",
 "SUBTITLE_SEE1_IGD_029A_REZN_A": "^1РЕЗНОВ: ^7Більше вогню з Panzerschreck! Знищ їх усіх!",
 "SUBTITLE_SEE1_IGD_030A_CHER": "^1ЧЕРНОВ: ^7Німецькі танки наближаються!",
 "SUBTITLE_SEE1_IGD_031A_REZN": "^1РЕЗНОВ: ^7Дмитре! Оберни їхню зброю проти них!",
 "SUBTITLE_SEE1_IGD_032A_REZN": "^1РЕЗНОВ: ^7Звари їх живцем у сталевих трунах!",
 "SUBTITLE_SEE1_IGD_033A_REZN": "^1РЕЗНОВ: ^7ЩЕ ТАНКИ!",
 "SUBTITLE_SEE1_IGD_034A_REZN": "^1РЕЗНОВ: ^7Вогонь!",
 "SUBTITLE_SEE1_IGD_035A_REZN": "^1РЕЗНОВ: ^7Піхота в пшениці!",
 "SUBTITLE_SEE1_IGD_036A_REZN_A": "^1РЕЗНОВ: ^7Коктейлі Молотова!... Підпаліть їх!",
 "SUBTITLE_SEE1_IGD_037A_REZN_A": "^1РЕЗНОВ: ^7Дмитре, бачу, час не притупив твого ока!",
 "SUBTITLE_SEE1_IGD_038A_REZN": "^1РЕЗНОВ: ^7З тобою перемога за нами!",
 "SUBTITLE_SEE1_IGD_039A_REZN_A": "^1РЕЗНОВ: ^7Герой Сталінграда!",
 "SUBTITLE_SEE1_IGD_040A_REZN_B": "^1РЕЗНОВ: ^7Що Дмитрові якісь танки?!",
 "SUBTITLE_SEE1_IGD_041A_REZN_A": "^1РЕЗНОВ: ^7Їхня броня тобі не суперник!",
 "SUBTITLE_SEE1_IGD_042A_CHER": "^1ЧЕРНОВ: ^7Сержанте! Panzerschreck у вікні!",
 "SUBTITLE_SEE1_IGD_043A_REZN": "^1РЕЗНОВ: ^7Назад! Хай ним займуться наші танки!",
 "SUBTITLE_SEE1_IGD_044A_REZN": "^1РЕЗНОВ: ^7ХА!",
 "SUBTITLE_SEE1_IGD_045A_REZN_A": "^1РЕЗНОВ: ^7За мною! Зберемося біля стодоли!",
 "SUBTITLE_SEE1_IGD_046A_REZN_A": "^1РЕЗНОВ: ^7Там... Підготуємося до останнього\nкидка на вокзал.",
 "SUBTITLE_SEE1_IGD_047A_REZN": "^1РЕЗНОВ: ^7ТОВАРИШІ!",
 "SUBTITLE_SEE1_IGD_048A_REZN_B": "^1РЕЗНОВ: ^7ЧОРТ! Ще один танк!",
 "SUBTITLE_SEE1_IGD_049A_REZN_A": "^1РЕЗНОВ: ^7Дмитре! Знищ його!",
 "SUBTITLE_SEE1_IGD_050A_REZN": "^1РЕЗНОВ: ^7Тобі є чого повчитися в цієї людини, Чернове...",
 "SUBTITLE_SEE1_IGD_051A_CHER": "^1ЧЕРНОВ: ^7Сержанте Резнове,\nздається, ви впиваєтеся цією різаниною.",
 "SUBTITLE_SEE1_IGD_052A_REZN_A": "^1РЕЗНОВ: ^7Я бачив, як друзі й сусіди\nгинули від рук цієї погані.",
 "SUBTITLE_SEE1_IGD_052B_REZN": "^1РЕЗНОВ: ^7Я бачив, як мої друзі гинули\nпросто в мене на очах від рук цієї погані.",
 "SUBTITLE_SEE1_IGD_053A_REZN_A": "^1РЕЗНОВ: ^7Вони заслуговують на все, що отримують...\nі навіть більше.",
 "SUBTITLE_SEE1_IGD_054A_REZN": "^1РЕЗНОВ: ^7Досить балачок.\nМи маємо прорватися до вокзалу!",
 "SUBTITLE_SEE1_IGD_055A_REZN_A": "^1РЕЗНОВ: ^7Ну, хлопці, час настав.",
 "SUBTITLE_SEE1_IGD_057A_REZN": "^1РЕЗНОВ: ^7Щойно зачистимо цю територію,\nзможемо святкувати велику перемогу.",
 "SUBTITLE_SEE1_IGD_058A_REZN": "^1РЕЗНОВ: ^7В АТАКУ!!!",
 "SUBTITLE_SEE1_IGD_059A_REZN_A": "^1РЕЗНОВ: ^7Знесіть ті вежі!",
 "SUBTITLE_SEE1_IGD_060A_REZN_A": "^1РЕЗНОВ: ^7Бий з Panzerschreck!",
 "SUBTITLE_SEE1_IGD_061A_REZN": "^1РЕЗНОВ: ^7Бронетранспортер! Швидко наближається!",
 "SUBTITLE_SEE1_IGD_062A_REZN_A": "^1РЕЗНОВ: ^7Вони слабшають!",
 "SUBTITLE_SEE1_IGD_063A_REZN": "^1РЕЗНОВ: ^7Добийте їх!",
 "SUBTITLE_SEE1_IGD_100A_CHER": "^1ЧЕРНОВ: ^7Дмитре! Не лізь у пшеницю!",
 "SUBTITLE_SEE1_IGD_102A_REZN": "^1РЕЗНОВ: ^7Хай горять!",
 "SUBTITLE_SEE1_IGD_104A_REZN": "^1РЕЗНОВ: ^7Поки наші літаки спопеляють цю землю,\nми розберемося з її звірами тут, унизу!",
 "SUBTITLE_SEE1_IGD_105A_REZN": "^1РЕЗНОВ: ^7Дмитре...\nОбійди кулемет, поки він не покосив нас усіх!",
 "SUBTITLE_SEE1_IGD_106A_CHER": "^1ЧЕРНОВ: ^7Сержанте! Німецькі вантажівки на мосту!",
 "SUBTITLE_SEE1_IGD_107A_REZN": "^1РЕЗНОВ: ^7Я ж казав, Чернове! Утекти не вдасться нікому!",
 "SUBTITLE_SEE1_IGD_109A_CHER": "^1ЧЕРНОВ: ^7Як? Хіба нашими гвинтівками проб'єш їхню броню?",
 "SUBTITLE_SEE1_IGD_110A_REZN": "^1РЕЗНОВ: ^7Дмитре, покажи Чернову, що робити.",
 "SUBTITLE_SEE1_IGD_112A_REZN": "^1РЕЗНОВ: ^7Швидше! Знищ танк!",
 "SUBTITLE_SEE1_IGD_113A_REZN": "^1РЕЗНОВ: ^7Їхній вогонь зупиняє наш наступ!",
 "SUBTITLE_SEE1_IGD_114A_REZN": "^1РЕЗНОВ: ^7Бий ракетами!",
 "SUBTITLE_SEE1_IGD_115A_REZN": "^1РЕЗНОВ: ^7Стріляй з Panzerschreck!",
 "SUBTITLE_SEE1_IGD_116A_REZN": "^1РЕЗНОВ: ^7ЩЕ!",
 "SUBTITLE_SEE1_IGD_117A_REZN": "^1РЕЗНОВ: ^7Не зупиняйтеся, доки не згорить останній!",
 "SUBTITLE_SEE1_IGD_118A_REZN": "^1РЕЗНОВ: ^7Кинь гранату всередину!",
 "SUBTITLE_SEE1_IGD_119A_REZN": "^1РЕЗНОВ: ^7Німецький снайпер! У вікні стодоли!",
 "SUBTITLE_SEE1_IGD_120A_REZN": "^1РЕЗНОВ: ^7Уперед, вибийте їх звідти!",
 "SUBTITLE_SEE1_IGD_121A_REZN": "^1РЕЗНОВ: ^7Вибий двері!",
 "SUBTITLE_SEE1_IGD_122A_REZN": "^1РЕЗНОВ: ^7Обережно!",
 "SUBTITLE_SEE1_IGD_123A_REZN": "^1РЕЗНОВ: ^7Боягузи можуть ховатися в тіні,\nале ми їх знайдемо!",
 "SUBTITLE_SEE1_IGD_124A_REZN": "^1РЕЗНОВ: ^7Дмитре, сідай на один із танків.\nТи заслужив на відпочинок.",
 "SUBTITLE_SEE1_IGD_125A_REZN": "^1РЕЗНОВ: ^7Чернове! А ти ні. Ти йдеш пішки.",
 "SUBTITLE_SEE1_IGD_126A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Місця нема, товаришу.\nСпробуй на танку позаду.",
 "SUBTITLE_SEE1_IGD_127A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Ти що, сліпий? Місця нема.",
 "SUBTITLE_SEE1_IGD_128A_CHER": "^1ЧЕРНОВ: ^7Німці в полі!",
 "SUBTITLE_SEE1_IGD_128B_CHER": "^1ЧЕРНОВ: ^7Німці в полі ліворуч!",
 "SUBTITLE_SEE1_IGD_129A_REZN": "^1РЕЗНОВ: ^7ХА! Розбігаються, як таргани від світла!",
 "SUBTITLE_SEE1_IGD_130A_REZN": "^1РЕЗНОВ: ^7Знімайте їх одного за одним!",
 "SUBTITLE_SEE1_IGD_131A_CHER": "^1ЧЕРНОВ: ^7Шлях перекрито...\nНаші танки не можуть пройти.",
 "SUBTITLE_SEE1_IGD_132A_REZN": "^1РЕЗНОВ: ^7Вони знайдуть обхід!",
 "SUBTITLE_SEE1_IGD_133A_REZN": "^1РЕЗНОВ: ^7Знайди ракети!",
 "SUBTITLE_SEE1_IGD_134A_REZN": "^1РЕЗНОВ: ^7Підірви ті вежі!",
 "SUBTITLE_SEE1_IGD_135A_REZN": "^1РЕЗНОВ: ^7Товариші, беріть приклад з Дмитра.",
 "SUBTITLE_SEE1_IGD_136A_REZN": "^1РЕЗНОВ: ^7Знищ вежі!",
 "SUBTITLE_SEE1_IGD_137A_CHER": "^1ЧЕРНОВ: ^7Підкріплення!",
 "SUBTITLE_SEE1_IGD_138A_CHER": "^1ЧЕРНОВ: ^7Німецька вантажівка наближається!",
 "SUBTITLE_SEE1_IGD_139A_REZN": "^1РЕЗНОВ: ^7Дмитре! Рознеси її на шматки,\nпоки вони не зайняли позиції!",
 "SUBTITLE_SEE1_IGD_140A_REZN": "^1РЕЗНОВ: ^7Ти, мабуть, найцінніший боєць Червоної армії!",
 "SUBTITLE_SEE1_IGD_141A_REZN": "^1РЕЗНОВ: ^7Бронетранспортер - їхня найсильніша зброя!",
 "SUBTITLE_SEE1_IGD_142A_REZN": "^1РЕЗНОВ: ^7Кулемет на бронетранспортері!",
 "SUBTITLE_SEE1_IGD_143A_REZN": "^1РЕЗНОВ: ^7Якщо скінчилися ракети,\nтоді всади кулю кулеметникові в голову!",
 "SUBTITLE_SEE1_IGD_144A_CHER": "^1ЧЕРНОВ: ^7Вони відходять!",
 "SUBTITLE_SEE1_IGD_145A_REZN": "^1РЕЗНОВ: ^7Неважливо, де вони вирішать померти!",
 "SUBTITLE_SEE1_IGD_146A_REZN": "^1РЕЗНОВ: ^7Полюйте на них!",
 "SUBTITLE_SEE1_IGD_147A_CHER": "^1ЧЕРНОВ: ^7Вони готові здатися.",
 "SUBTITLE_SEE1_IGD_148A_REZN": "^1РЕЗНОВ: ^7А ми не готові їм це дозволити.",
 "SUBTITLE_SEE1_IGD_149A_REZN": "^1РЕЗНОВ: ^7Моїх товаришів у Сталінграді\nніхто не помилував.",
 "SUBTITLE_SEE1_IGD_150A_REZN": "^1РЕЗНОВ: ^7І тут пощади не буде нікому.",
 "SUBTITLE_SEE1_IGD_151A_REZN": "^1РЕЗНОВ: ^7Око за око!!!",
 "SUBTITLE_SEE1_IGD_200A_REZN": "^1РЕЗНОВ: ^7Перемога вже близько! Німецькі боягузи \nкидають позиції, але тікати їм уже нікуди!\nЗметіть рештки їхньої розбитої лінії \nі захопіть вокзал. Відтепер...\nКожен наш крок наближає нас до Берліна.\nБлижче до перемоги! Ближче до помсти! УРА!!!!",
 "SUBTITLE_SEE1_IGD_200B_REZN": "^1РЕЗНОВ: ^7Перемога вже близько! Німецькі боягузи \nкидають позиції, але тікати їм уже нікуди!",
 "SUBTITLE_SEE1_IGD_200C_REZN": "^1РЕЗНОВ: ^7Відтепер...  \nКожен наш крок наближає нас до Берліна.\nБлижче до перемоги! Ближче до помсти! УРА!!!!",
 "SUBTITLE_SEE1_IGD_300A_REZN": "^1РЕЗНОВ: ^7Бийте з Panzerschreck!",
 "SUBTITLE_SEE1_IGD_301A_REZN": "^1РЕЗНОВ: ^7Бийте з Panzerschreck по тих вежах!",
 "SUBTITLE_SEE1_IGD_302A_REZN": "^1РЕЗНОВ: ^7Вогонь із Panzerschreck!",
 "SUBTITLE_SEE1_IGD_700A_RURS": "^1РАДЯНСЬКІ СОЛДАТИ: ^7УРА!",
 "SUBTITLE_SEE1_IGD_701A_RURS": "^1РАДЯНСЬКІ СОЛДАТИ: ^7УРА!",
 "SUBTITLE_SEE1_IGD_702A_RURS": "^1РАДЯНСЬКІ СОЛДАТИ: ^7УРА!",
 "SUBTITLE_SEE1_IGD_703A_RURS": "^1РАДЯНСЬКІ СОЛДАТИ: ^7(гомін)",
 "SUBTITLE_SEE1_INT_011A_REZN_C": "^1РЕЗНОВ: ^7Дмитре?",
 "SUBTITLE_SEE1_INT_012A_REZN_CA": "^1РЕЗНОВ: ^7Добий цих щурів...",
 "SUBTITLE_SEE1_INT_013A_REZN_E": "^1РЕЗНОВ: ^7Ти знову обдурив смерть.",
 "SUBTITLE_SEE1_INT_014A_REZN_A_CA": "^1РЕЗНОВ: ^7Наші танки готові розтрощити цю лінію і...",
 "SUBTITLE_SEE1_INT_015A_REZN": "^1РЕЗНОВ: ^7ЧЕРНОВЕ! Я не чую пострілів.",
 "SUBTITLE_SEE1_INT_016A_CHER": "^1ЧЕРНОВ: ^7Нема сенсу, сержанте...\nВони й так стікають кров'ю.",
 "SUBTITLE_SEE1_INT_017A_REZN_A": "^1РЕЗНОВ: ^7Тоді, може, наш друг допоможе\nїм стекти кров'ю швидше.",
 "SUBTITLE_SEE1_INT_018A_REZN_D": "^1РЕЗНОВ: ^7Вибір за тобою.",
 "SUBTITLE_SEE2_IGD_000A_COMM": "^1КОМІСАР: ^7Хоробрі товариші з 3-ї ударної армії...",
 "SUBTITLE_SEE2_IGD_001A_COMM": "^1КОМІСАР: ^7Сьогодні ми зітремо німецьку оборону на порох!",
 "SUBTITLE_SEE2_IGD_002A_REZN": "^1РЕЗНОВ: ^7Дмитре, готуй вогнемет.",
 "SUBTITLE_SEE2_IGD_003A_REZN": "^1РЕЗНОВ: ^7Добре. А тепер придивися\nдо тих щурів на обрії!",
 "SUBTITLE_SEE2_IGD_004A_REZN": "^1РЕЗНОВ: ^7Сьогодні вони згорять першими!",
 "SUBTITLE_SEE2_IGD_005A_REZN": "^1РЕЗНОВ: ^7Пали з вогнемета! Спопели їх!",
 "SUBTITLE_SEE2_IGD_006A_REZN": "^1РЕЗНОВ: ^7Горіть! Горіть! ГОРІТЬ!!!",
 "SUBTITLE_SEE2_IGD_007A_REZN": "^1РЕЗНОВ: ^7Перша 88-ка... на південному заході!",
 "SUBTITLE_SEE2_IGD_007B_REZN": "^1РЕЗНОВ: ^7Перша 88-ка",
 "SUBTITLE_SEE2_IGD_008A_REZN": "^1РЕЗНОВ: ^7Цілься!",
 "SUBTITLE_SEE2_IGD_009A_REZN": "^1РЕЗНОВ: ^7Ха! Перша з багатьох, друже мій!",
 "SUBTITLE_SEE2_IGD_010A_REZN_A": "^1РЕЗНОВ: ^7Не зупиняйся!",
 "SUBTITLE_SEE2_IGD_011A_REZN_A": "^1РЕЗНОВ: ^7Пам'ятай: поки перезаряджаємо,\nми вразливі. Кожен снаряд - у ціль!",
 "SUBTITLE_SEE2_IGD_012A_REZN": "^1РЕЗНОВ: ^7Пантера! Насувається з заходу!",
 "SUBTITLE_SEE2_IGD_013A_REZN": "^1РЕЗНОВ: ^7Знищ її! Пантера швидка,\nі через це вона смертельно небезпечна!",
 "SUBTITLE_SEE2_IGD_014A_REZN": "^1РЕЗНОВ: ^7Вогонь!!!",
 "SUBTITLE_SEE2_IGD_015A_REZN": "^1РЕЗНОВ: ^7Ще! Поки вона не навелася на нас.",
 "SUBTITLE_SEE2_IGD_016A_REZN": "^1РЕЗНОВ: ^7Вдалого полювання!",
 "SUBTITLE_SEE2_IGD_017A_REZN": "^1РЕЗНОВ: ^7Друга 88-ка на пагорбі!... На південному заході!",
 "SUBTITLE_SEE2_IGD_017B_REZN": "^1РЕЗНОВ: ^7Друга 88-ка на пагорбі!",
 "SUBTITLE_SEE2_IGD_018A_REZN": "^1РЕЗНОВ: ^7Вогонь!!!",
 "SUBTITLE_SEE2_IGD_019A_REZN": "^1РЕЗНОВ: ^7Мінус дві!",
 "SUBTITLE_SEE2_IGD_020A_COMM": "^1КОМІСАР: ^7Уперед!!!\nЩе лишилися 88-ки на захід і південь від вас!",
 "SUBTITLE_SEE2_IGD_020B_COMM": "^1КОМІСАР: ^7Уперед!!! Ще лишилися 88-ки!",
 "SUBTITLE_SEE2_IGD_021A_REZN": "^1РЕЗНОВ: ^7Дмитре, обирай шлях!",
 "SUBTITLE_SEE2_IGD_022A_REZN_A": "^1РЕЗНОВ: ^7Їдь дорогою або прорвися через поле!",
 "SUBTITLE_SEE2_IGD_023A_REZN": "^1РЕЗНОВ: ^7Ще дві 88-ки на південному заході!",
 "SUBTITLE_SEE2_IGD_024A_REZN": "^1РЕЗНОВ: ^7Ха! До наступної!",
 "SUBTITLE_SEE2_IGD_025A_REZN": "^1РЕЗНОВ: ^7Лишилося ще дві, там, на півночі!",
 "SUBTITLE_SEE2_IGD_025B_REZN": "^1РЕЗНОВ: ^7Лишилося ще дві!",
 "SUBTITLE_SEE2_IGD_026A_REZN": "^1РЕЗНОВ: ^7Ще дві 88-ки на північному заході!",
 "SUBTITLE_SEE2_IGD_026B_REZN": "^1РЕЗНОВ: ^7Ще дві 88-ки досі стоять!",
 "SUBTITLE_SEE2_IGD_027A_REZN": "^1РЕЗНОВ: ^7Добий їх!!!",
 "SUBTITLE_SEE2_IGD_028A_REZN": "^1РЕЗНОВ: ^7Прощавайте!!",
 "SUBTITLE_SEE2_IGD_029A_REZN_A": "^1РЕЗНОВ: ^7Ура!",
 "SUBTITLE_SEE2_IGD_030A_REZN": "^1РЕЗНОВ: ^7Ще дві. Ще дві, там, на півдні!",
 "SUBTITLE_SEE2_IGD_030B_REZN": "^1РЕЗНОВ: ^7Уперед, на дві останні 88-ки!",
 "SUBTITLE_SEE2_IGD_031A_REZN": "^1РЕЗНОВ: ^7Навколо німецькі танки, Дмитре!",
 "SUBTITLE_SEE2_IGD_032A_REZN": "^1РЕЗНОВ: ^7Нас можуть атакувати з усіх боків!",
 "SUBTITLE_SEE2_IGD_033A_REZN": "^1РЕЗНОВ: ^7Не зупиняйся!",
 "SUBTITLE_SEE2_IGD_034A_REZN_A": "^1РЕЗНОВ: ^7Panzerschreck! У вежі!",
 "SUBTITLE_SEE2_IGD_035A_REZN": "^1РЕЗНОВ: ^7Ще Panzerschreck!",
 "SUBTITLE_SEE2_IGD_036A_REZN": "^1РЕЗНОВ: ^7Знеси вежі!",
 "SUBTITLE_SEE2_IGD_037A_COMM": "^1КОМІСАР: ^7Вогонь по них!",
 "SUBTITLE_SEE2_IGD_038A_REZN": "^1РЕЗНОВ: ^7Уперед! Знищ дві останні 88-ки!",
 "SUBTITLE_SEE2_IGD_039A_REZN": "^1РЕЗНОВ: ^7Лишилася одна!",
 "SUBTITLE_SEE2_IGD_040A_REZN": "^1РЕЗНОВ: ^7Чудова робота, Дмитре!",
 "SUBTITLE_SEE2_IGD_041A_REZN": "^1РЕЗНОВ: ^7Уперед!",
 "SUBTITLE_SEE2_IGD_042A_COMM": "^1КОМІСАР: ^7Увага, товариші!\nУперед, зрівняйте з землею фашистську радіовежу.",
 "SUBTITLE_SEE2_IGD_043A_REZN": "^1РЕЗНОВ: ^7Їдь дорогою на північний захід!",
 "SUBTITLE_SEE2_IGD_044A_REZN": "^1РЕЗНОВ: ^7Радіовежа на півночі!",
 "SUBTITLE_SEE2_IGD_045A_REZN": "^1РЕЗНОВ: ^7Зітри її на порох!",
 "SUBTITLE_SEE2_IGD_046A_REZN": "^1РЕЗНОВ: ^7Добра робота, Дмитре, тепер вони\nне покличуть підкріплення!",
 "SUBTITLE_SEE2_IGD_047A_COMM": "^1КОМІСАР: ^7Сьогодні ми прорвемо цю лінію!",
 "SUBTITLE_SEE2_IGD_048A_COMM": "^1КОМІСАР: ^7Уперед, знищте паливний склад!\nПаралізуйте їхню військову машину!",
 "SUBTITLE_SEE2_IGD_100A_COMM": "^1КОМІСАР: ^7Пам'ятайте: під час перезаряджання\nви вразливі!",
 "SUBTITLE_SEE2_IGD_101A_COMM": "^1КОМІСАР: ^7Уперед, до вокзалу!",
 "SUBTITLE_SEE2_IGD_102A_REZN": "^1РЕЗНОВ: ^7Дивись, наша піхота наступає!",
 "SUBTITLE_SEE2_IGD_103A_COMM": "^1КОМІСАР: ^7Тисніть далі!",
 "SUBTITLE_SEE2_IGD_104A_REZN": "^1РЕЗНОВ: ^7На Берлін!!!",
 "SUBTITLE_SEE2_IGD_105A_REZN": "^1РЕЗНОВ: ^7Німецька піхота!",
 "SUBTITLE_SEE2_IGD_106A_REZN": "^1РЕЗНОВ: ^7Розчави їх!",
 "SUBTITLE_SEE2_IGD_107A_REZN": "^1РЕЗНОВ: ^7Здери м'ясо з їхніх кісток!",
 "SUBTITLE_SEE2_IGD_108A_REZN": "^1РЕЗНОВ: ^7Рушай!",
 "SUBTITLE_SEE2_IGD_109A_REZN": "^1РЕЗНОВ: ^7Не сиди на місці, Дмитре!",
 "SUBTITLE_SEE2_IGD_110A_REZN": "^1РЕЗНОВ: ^7Швидше... Дмитре!",
 "SUBTITLE_SEE2_IGD_111A_REZN": "^1РЕЗНОВ: ^7Ми могли б зараз палити німців!",
 "SUBTITLE_SEE2_IGD_112A_REZN": "^1РЕЗНОВ: ^7Чого ти чекаєш?!",
 "SUBTITLE_SEE2_IGD_113A_REZN": "^1РЕЗНОВ: ^7Вивези нас звідси!",
 "SUBTITLE_SEE2_IGD_200A_REZN": "^1РЕЗНОВ: ^7Залий їхні мерзенні голови вогнем!",
 "SUBTITLE_SEE2_IGD_201A_REZN": "^1РЕЗНОВ: ^7Дай їм скуштувати пекла!!!",
 "SUBTITLE_SEE2_IGD_202A_REZN": "^1РЕЗНОВ: ^7Покажи їм лють, яку вони самі збудили!",
 "SUBTITLE_SEE2_IGD_500A_REZN": "^1РЕЗНОВ: ^7Ще піхота!",
 "SUBTITLE_SEE2_IGD_501A_REZN": "^1РЕЗНОВ: ^7Ха! Їм нікуди тікати!",
 "SUBTITLE_SEE2_IGD_502A_REZN": "^1РЕЗНОВ: ^7Переїдь їх! Потрощи їм кістки!",
 "SUBTITLE_SEE2_IGD_503A_REZN_A": "^1РЕЗНОВ: ^7Німецька бронетехніка!",
 "SUBTITLE_SEE2_IGD_504A_REZN": "^1РЕЗНОВ: ^7Ворожі танки!",
 "SUBTITLE_SEE2_IGD_505A_REZN": "^1РЕЗНОВ: ^7Ще один танк!",
 "SUBTITLE_SEE2_IGD_506A_REZN": "^1РЕЗНОВ: ^7Королівський тигр!",
 "SUBTITLE_SEE2_IGD_507A_REZN": "^1РЕЗНОВ: ^7У Королівського тигра міцна шкура!\nВОГОНЬ ЩЕ РАЗ!",
 "SUBTITLE_SEE2_IGD_508A_REZN": "^1РЕЗНОВ: ^7Німецький танк!",
 "SUBTITLE_SEE2_IGD_509A_REZN": "^1РЕЗНОВ: ^7Транспорт із піхотою!",
 "SUBTITLE_SEE2_IGD_510A_REZN": "^1РЕЗНОВ: ^7Не дай їм утекти!",
 "SUBTITLE_SEE2_IGD_511A_REZN": "^1РЕЗНОВ: ^7Рознеси їх на шматки!",
 "SUBTITLE_SEE2_IGD_512A_REZN": "^1РЕЗНОВ: ^7На півночі!",
 "SUBTITLE_SEE2_IGD_513A_REZN": "^1РЕЗНОВ: ^7На північному сході!",
 "SUBTITLE_SEE2_IGD_514A_REZN": "^1РЕЗНОВ: ^7На сході!",
 "SUBTITLE_SEE2_IGD_515A_REZN": "^1РЕЗНОВ: ^7На південному сході!",
 "SUBTITLE_SEE2_IGD_516A_REZN": "^1РЕЗНОВ: ^7На півдні!",
 "SUBTITLE_SEE2_IGD_517A_REZN": "^1РЕЗНОВ: ^7На південному заході!",
 "SUBTITLE_SEE2_IGD_518A_REZN": "^1РЕЗНОВ: ^7На заході!",
 "SUBTITLE_SEE2_IGD_519A_REZN_A": "^1РЕЗНОВ: ^7На північному заході!",
 "SUBTITLE_SEE2_IGD_520A_REZN": "^1РЕЗНОВ: ^7Прямо попереду!",
 "SUBTITLE_SEE2_IGD_521A_REZN": "^1РЕЗНОВ: ^7Позаду!",
 "SUBTITLE_SEE2_IGD_522A_REZN_A": "^1РЕЗНОВ: ^7У полі!",
 "SUBTITLE_SEE2_IGD_523A_REZN": "^1РЕЗНОВ: ^7На пагорбі!",
 "SUBTITLE_SEE2_IGD_524A_REZN": "^1РЕЗНОВ: ^7На болоті!",
 "SUBTITLE_SEE2_IGD_525A_REZN": "^1РЕЗНОВ: ^7Він узяв нас на приціл!",
 "SUBTITLE_SEE2_IGD_526A_REZN": "^1РЕЗНОВ: ^7Займи кращу позицію.",
 "SUBTITLE_SEE2_IGD_527A_REZN": "^1РЕЗНОВ: ^7Нас обстрілюють!",
 "SUBTITLE_SEE2_IGD_528A_REZN": "^1РЕЗНОВ: ^7У нас влучили! РУШАЙ!",
 "SUBTITLE_SEE2_IGD_529A_REZN": "^1РЕЗНОВ: ^7Броня не витримує!",
 "SUBTITLE_SEE2_IGD_530A_REZN": "^1РЕЗНОВ: ^7Ще кілька влучань - і ми згоримо живцем!",
 "SUBTITLE_SEE2_IGD_531A_REZN": "^1РЕЗНОВ: ^7Рушай!!!",
 "SUBTITLE_SEE2_IGD_532A_REZN": "^1РЕЗНОВ: ^7Ми проб'ємося до вокзалу...\nА тоді - на Берлін!",
 "SUBTITLE_SEE2_IGD_533A_REZN": "^1РЕЗНОВ: ^7Більше вогню з Panzerschreck! Знищ їх усіх!",
 "SUBTITLE_SEE2_IGD_534A_REZN": "^1РЕЗНОВ: ^7Там... Підготуємося до останнього\nкидка на вокзал.",
 "SUBTITLE_SEE2_IGD_535A_REZN": "^1РЕЗНОВ: ^7Досить балачок. Ми маємо\nпрорватися до вокзалу!",
 "SUBTITLE_SEE2_IGD_536A_REZN": "^1РЕЗНОВ: ^7Останній кидок - а тоді на Берлін.",
 "SUBTITLE_SEE2_IGD_537A_REZN": "^1РЕЗНОВ: ^7Знесіть ті вежі!",
 "SUBTITLE_SEE2_IGD_600A_REZN": "^1РЕЗНОВ: ^7Стріляй!!!",
 "SUBTITLE_SEE2_IGD_601A_REZN": "^1РЕЗНОВ: ^7Вогонь!!!",
 "SUBTITLE_SEE2_IGD_602A_REZN": "^1РЕЗНОВ: ^7Рознеси його на шматки!",
 "SUBTITLE_SEE2_IGD_603A_REZN": "^1РЕЗНОВ: ^7Вогонь, негайно!!!",
 "SUBTITLE_SEE2_IGD_604A_REZN": "^1РЕЗНОВ: ^7Знищ їх!",
 "SUBTITLE_SEE2_IGD_605A_REZN": "^1РЕЗНОВ: ^7Спали їх!",
 "SUBTITLE_SEE2_IGD_606A_REZN": "^1РЕЗНОВ: ^7Підсмаж їх!",
 "SUBTITLE_SEE2_IGD_607A_REZN": "^1РЕЗНОВ: ^7Спопели їх!",
 "SUBTITLE_SEE2_IGD_608A_REZN": "^1РЕЗНОВ: ^7Німецький бункер!",
 "SUBTITLE_SEE2_IGD_609A_REZN": "^1РЕЗНОВ: ^7Німецький опорний пункт!",
 "SUBTITLE_SEE2_IGD_610A_REZN": "^1РЕЗНОВ: ^7Вежа!",
 "SUBTITLE_SEE2_IGD_611A_REZN": "^1РЕЗНОВ: ^7Знеси ту вежу!",
 "SUBTITLE_SEE2_IGD_612A_REZN": "^1РЕЗНОВ: ^7Знищ вежу!",
 "SUBTITLE_SEE2_IGD_613A_REZN": "^1РЕЗНОВ: ^7Повертай праворуч!",
 "SUBTITLE_SEE2_IGD_614A_REZN": "^1РЕЗНОВ: ^7Праворуч!",
 "SUBTITLE_SEE2_IGD_615A_REZN": "^1РЕЗНОВ: ^7Справа від нас!",
 "SUBTITLE_SEE2_IGD_616A_REZN": "^1РЕЗНОВ: ^7Різко праворуч!",
 "SUBTITLE_SEE2_IGD_617A_REZN": "^1РЕЗНОВ: ^7Повертай ліворуч!",
 "SUBTITLE_SEE2_IGD_618A_REZN": "^1РЕЗНОВ: ^7Ліворуч!",
 "SUBTITLE_SEE2_IGD_619A_REZN": "^1РЕЗНОВ: ^7Зліва від нас!",
 "SUBTITLE_SEE2_IGD_620A_REZN": "^1РЕЗНОВ: ^7Різко ліворуч!",
 "SUBTITLE_SEE2_IGD_621A_REZN": "^1РЕЗНОВ: ^7Прямо попереду!",
 "SUBTITLE_SEE2_IGD_622A_REZN": "^1РЕЗНОВ: ^7Позаду!",
 "SUBTITLE_SEE2_IGD_623A_COMM": "^1КОМІСАР: ^7Добра робота, товариші!",
 "SUBTITLE_SEE2_IGD_624A_COMM": "^1КОМІСАР: ^7Ніякої пощади!",
 "SUBTITLE_SEE2_IGD_625A_REZN": "^1РЕЗНОВ: ^7Прощавай, мерзото!",
 "SUBTITLE_SEE2_IGD_626A_REZN": "^1РЕЗНОВ: ^7Влучно!",
 "SUBTITLE_SEE2_IGD_627A_REZN": "^1РЕЗНОВ: ^7Пряме влучання!",
 "SUBTITLE_SEE2_IGD_628A_REZN": "^1РЕЗНОВ: ^7Ідеальний постріл!",
 "SUBTITLE_SEE2_IGD_629A_REZN": "^1РЕЗНОВ: ^7Ха-ха!",
 "SUBTITLE_SEE2_IGD_630A_REZN": "^1РЕЗНОВ: ^7Знищено!",
 "SUBTITLE_SEE2_IGD_700A_REZN": "^1РЕЗНОВ: ^7Ми втратили хід!",
 "SUBTITLE_SEE2_IGD_701A_REZN": "^1РЕЗНОВ: ^7Ми тут як на долоні!",
 "SUBTITLE_SEE2_IGD_702A_REZN": "^1РЕЗНОВ: ^7Чорт! Німецькі танки наближаються...",
 "SUBTITLE_SEE2_IGD_703A_COMM": "^1КОМІСАР: ^7Вокзал уже майже наш!",
 "SUBTITLE_SEE2_IGD_704A_COMM": "^1КОМІСАР: ^7Поки наші літаки сіють смерть з неба,\nрозтрощіть їхні останні позиції!",
 "SUBTITLE_SEE2_IGD_705A_COMM": "^1КОМІСАР: ^7Товариші! Велика перемога за нами!",
 "SUBTITLE_SEE2_IGD_706A_COMM": "^1КОМІСАР: ^7На Берлін!!!",
 "SUBTITLE_SEE2_IGD_707A_COMM": "^1КОМІСАР: ^7Ура!!!!",
 "SUBTITLE_SEE2_IGD_800A_REZN": "^1РЕЗНОВ: ^7Вогонь по тих бункерах!",
 "SUBTITLE_SEE2_IGD_801A_REZN": "^1РЕЗНОВ: ^7Спали їх у їхніх бункерах!",
 "SUBTITLE_SEE2_IGD_802A_REZN": "^1РЕЗНОВ: ^7Пусти вогонь у ті бункери!",
 "SUBTITLE_SEE2_OUT_000A_REZN": "^1РЕЗНОВ: ^7Сьогодні був лише початок, товариші...",
 "SUBTITLE_SEE2_OUT_001A_REZN": "^1РЕЗНОВ: ^7У Берліні німці по-справжньому\nпобачать, що вони розв'язали!",
 "SUBTITLE_SEE2_OUT_002A_REZN": "^1РЕЗНОВ: ^7Фортуна нам усміхається!",
 "SUBTITLE_SEE2_OUT_004A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Я вбив щонайменше двадцятьох!\nТрьох - голими руками!",
 "SUBTITLE_SEE2_OUT_005A_RUR2": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Брехун! Коли ми стояли по коліна\nв крові, ти повзав на череві!",
 "SUBTITLE_SEE2_OUT_006A_RUR2": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Твоє щастя, що комісара\nпоряд не було!",
 "SUBTITLE_SEE2_OUT_007A_RUR2": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Він би наказав\nрозстріляти тебе за боягузтво!",
 "SUBTITLE_SEE2_OUT_008A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7А як там хоробрий Чернов?\nСкількох ти вбив... Трьох?",
 "SUBTITLE_SEE2_OUT_009A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Двох?!",
 "SUBTITLE_SEE2_OUT_010A_CHER": "^1ЧЕРНОВ: ^7Я не рахував.",
 "SUBTITLE_SEE2_OUT_011A_RUR2": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7А ти хоч стріляв?!!!",
 "SUBTITLE_SEE2_OUT_012A_REZN": "^1РЕЗНОВ: ^7Посеред усієї крові,\nкуль і мерців... я побачив, що\nмій старий друг живий-живісінький...\nДмитро Петренко!",
 "SUBTITLE_SEE2_OUT_013A_REZN_B": "^1РЕЗНОВ: ^7Я бачив, як ця людина обдурювала смерть... \nраз у раз під час облоги Сталінграда.",
 "SUBTITLE_SEE2_OUT_014A_REZN_B": "^1РЕЗНОВ: ^7Поки живий ВІН,\nсерце цієї армії не зламати.",
 "SUBTITLE_SEE2_OUT_015A_REZN_A": "^1РЕЗНОВ: ^7Ми всі ним пишаємося.",
 "SUBTITLE_SNI1_IGD_000A_REZN": "^1РЕЗНОВ: ^7Тссс...",
 "SUBTITLE_SNI1_IGD_001A_REZN": "^1РЕЗНОВ: ^7Мені потрібна твоя допомога.",
 "SUBTITLE_SNI1_IGD_002A_REZN_A": "^1РЕЗНОВ: ^7Пригнися й іди за мною.",
 "SUBTITLE_SNI1_IGD_003A_REZN_B": "^1РЕЗНОВ: ^7Візьми мою гвинтівку",
 "SUBTITLE_SNI1_IGD_003B_REZN": "^1РЕЗНОВ: ^7Візьми мою гвинтівку й стеж за дорогою.",
 "SUBTITLE_SNI1_IGD_004A_REZN": "^1РЕЗНОВ: ^7Покидьок у машині - це генерал\nГенріх Амзель, архітектор сталінградського пекла.",
 "SUBTITLE_SNI1_IGD_005A_REZN": "^1РЕЗНОВ: ^7На його совісті холоднокровні \nвбивства чоловіків, жінок і дітей...\nНе тільки тут, а по всій Батьківщині.",
 "SUBTITLE_SNI1_IGD_006A_REZN_C": "^1РЕЗНОВ: ^7Три дні я полюю на нього. \nТри дні лише везіння рятує його мерзенне життя.",
 "SUBTITLE_SNI1_IGD_008A_REZN": "^1РЕЗНОВ: ^7Тепер заряди гвинтівку, але не стріляй.",
 "SUBTITLE_SNI1_IGD_009A_REZN_A": "^1РЕЗНОВ: ^7Чекай, поки бомбардувальники не опиняться просто над нами.",
 "SUBTITLE_SNI1_IGD_010A_REZN": "^1РЕЗНОВ: ^7Гуркіт їхніх моторів\nзаглушить твій постріл.",
 "SUBTITLE_SNI1_IGD_011A_REZN_A": "^1РЕЗНОВ: ^7Снайпер полює на ворога так само,\nяк мисливець на будь-якого звіра.",
 "SUBTITLE_SNI1_IGD_012A_REZN_A": "^1РЕЗНОВ: ^7Вистрілиш не в ту мить - і твій\nшанс буде втрачено назавжди.",
 "SUBTITLE_SNI1_IGD_013A_REZN": "^1РЕЗНОВ: ^7Терпіння.",
 "SUBTITLE_SNI1_IGD_014A_REZN_A": "^1РЕЗНОВ: ^7Ще ні.",
 "SUBTITLE_SNI1_IGD_015A_REZN_B": "^1РЕЗНОВ: ^7СТРІЛЯЙ!",
 "SUBTITLE_SNI1_IGD_016A_REZN": "^1РЕЗНОВ: ^7Ще!",
 "SUBTITLE_SNI1_IGD_017A_REZN_A": "^1РЕЗНОВ: ^7Ще праворуч!",
 "SUBTITLE_SNI1_IGD_018A_REZN_A": "^1РЕЗНОВ: ^7Ліворуч!",
 "SUBTITLE_SNI1_IGD_019A_REZN": "^1РЕЗНОВ: ^7Цілься лівіше!",
 "SUBTITLE_SNI1_IGD_020A_REZN_A": "^1РЕЗНОВ: ^7Цілься правіше!",
 "SUBTITLE_SNI1_IGD_021A_REZN": "^1РЕЗНОВ: ^7Прямо попереду!",
 "SUBTITLE_SNI1_IGD_022A_REZN_B": "^1РЕЗНОВ: ^7Ще четверо на ногах!",
 "SUBTITLE_SNI1_IGD_023A_REZN_A": "^1РЕЗНОВ: ^7Швидше! Поки бомбардувальники не пролетіли!",
 "SUBTITLE_SNI1_IGD_024A_REZN_A": "^1РЕЗНОВ: ^7ХА!",
 "SUBTITLE_SNI1_IGD_025A_REZN_A": "^1РЕЗНОВ: ^7Лишилося троє!",
 "SUBTITLE_SNI1_IGD_026A_REZN": "^1РЕЗНОВ: ^7Обережно! Собака!",
 "SUBTITLE_SNI1_IGD_027A_REZN_A": "^1РЕЗНОВ: ^7Реакція могла б бути й швидшою,\nале справу зроблено.",
 "SUBTITLE_SNI1_IGD_028A_REZN_A": "^1РЕЗНОВ: ^7Ти влучно стріляєш, товаришу.",
 "SUBTITLE_SNI1_IGD_029A_REZN": "^1РЕЗНОВ: ^7Чудовий постріл! Ти природжений мисливець.",
 "SUBTITLE_SNI1_IGD_030A_REZN_C": "^1РЕЗНОВ: ^7Час підібратися ближче й добити здобич.",
 "SUBTITLE_SNI1_IGD_031A_REZN": "^1РЕЗНОВ: ^7Чорт!",
 "SUBTITLE_SNI1_IGD_032A_REZN_B": "^1РЕЗНОВ: ^7Броньований патруль...\nТреба знайти інший шлях до Амзеля.",
 "SUBTITLE_SNI1_IGD_033A_REZN_A": "^1РЕЗНОВ: ^7Сюди, поки вони не знайшли своїх мерців.",
 "SUBTITLE_SNI1_IGD_034A_REZN_B": "^1РЕЗНОВ: ^7Тепер починається справжнє полювання.",
 "SUBTITLE_SNI1_IGD_035A_REZN_C": "^1РЕЗНОВ: ^7Кілька днів я пробирався\nтінями, мов щур.",
 "SUBTITLE_SNI1_IGD_037A_REZN_C": "^1РЕЗНОВ: ^7Колись тут лунали\nрозмови друзів і закоханих.",
 "SUBTITLE_SNI1_IGD_038A_REZN_B": "^1РЕЗНОВ: ^7Але не тепер.",
 "SUBTITLE_SNI1_IGD_039A_REZN_D": "^1РЕЗНОВ: ^7Запам'ятай мої слова, товаришу...",
 "SUBTITLE_SNI1_IGD_040A_REZN_B": "^1РЕЗНОВ: ^7Одного дня все зміниться.",
 "SUBTITLE_SNI1_IGD_041A_REZN_A": "^1РЕЗНОВ: ^7Ми принесемо війну на їхню землю... \nдо їхнього народу... до їхньої крові.",
 "SUBTITLE_SNI1_IGD_042A_REZN_A": "^1РЕЗНОВ: ^7Сюди.",
 "SUBTITLE_SNI1_IGD_043A_REZN": "^1РЕЗНОВ: ^7Хто знає звички й шляхи своєї\nздобичі, той має перевагу на полюванні.",
 "SUBTITLE_SNI1_IGD_044A_REZN": "^1РЕЗНОВ: ^7Генерал Амзель - раб своїх звичок.",
 "SUBTITLE_SNI1_IGD_045A_REZN": "^1РЕЗНОВ: ^7Щодня він інспектує кожен німецький гарнізон.",
 "SUBTITLE_SNI1_IGD_046A_REZN": "^1РЕЗНОВ: ^7Ця будівля дасть нам вийти йому у фланг.",
 "SUBTITLE_SNI1_IGD_047A_REZN_A": "^1РЕЗНОВ: ^7Снайпер!",
 "SUBTITLE_SNI1_IGD_048A_REZN": "^1РЕЗНОВ: ^7Мерщій усередину!",
 "SUBTITLE_SNI1_IGD_049A_REZN_A": "^1РЕЗНОВ: ^7Мерзотник ледь мене не підстрелив.\nДоведеться викурити його, перш ніж іти далі.",
 "SUBTITLE_SNI1_IGD_050A_REZN_A": "^1РЕЗНОВ: ^7За мною.",
 "SUBTITLE_SNI1_IGD_051A_REZN_A": "^1РЕЗНОВ: ^7Стріляли з того берега річки!",
 "SUBTITLE_SNI1_IGD_052A_REZN_B": "^1РЕЗНОВ: ^7Тепер почнеться гра в кота й мишку.",
 "SUBTITLE_SNI1_IGD_053A_REZN_B": "^1РЕЗНОВ: ^7Я викличу його вогонь на себе.\nВиглядай спалах.",
 "SUBTITLE_SNI1_IGD_054A_REZN_A": "^1РЕЗНОВ: ^7Готовий?",
 "SUBTITLE_SNI1_IGD_055A_REZN_B": "^1РЕЗНОВ: ^7Зараз!",
 "SUBTITLE_SNI1_IGD_056A_REZN_A": "^1РЕЗНОВ: ^7Він на четвертому поверсі, праворуч!",
 "SUBTITLE_SNI1_IGD_056B_REZN_A": "^1РЕЗНОВ: ^7Він на верхньому поверсі, праворуч!",
 "SUBTITLE_SNI1_IGD_057A_REZN_A": "^1РЕЗНОВ: ^7Третій поверх! Праворуч!",
 "SUBTITLE_SNI1_IGD_057B_REZN_A": "^1РЕЗНОВ: ^7Нижче, другий поверх! Праворуч!",
 "SUBTITLE_SNI1_IGD_058A_REZN": "^1РЕЗНОВ: ^7Він на четвертому поверсі, ліворуч!",
 "SUBTITLE_SNI1_IGD_058B_REZN_A": "^1РЕЗНОВ: ^7Він на верхньому поверсі, ліворуч!",
 "SUBTITLE_SNI1_IGD_059A_REZN": "^1РЕЗНОВ: ^7Третій поверх! Ліворуч!",
 "SUBTITLE_SNI1_IGD_059B_REZN_A": "^1РЕЗНОВ: ^7Нижче, другий поверх! Ліворуч!",
 "SUBTITLE_SNI1_IGD_060A_REZN": "^1РЕЗНОВ: ^7Я знову викличу його вогонь на себе,\nготуйся зняти його...",
 "SUBTITLE_SNI1_IGD_061A_REZN": "^1РЕЗНОВ: ^7Чорт!!!",
 "SUBTITLE_SNI1_IGD_062A_REZN_A": "^1РЕЗНОВ: ^7Ти його бачив?",
 "SUBTITLE_SNI1_IGD_063A_REZN_B": "^1РЕЗНОВ: ^7Він точно знає, де ми.",
 "SUBTITLE_SNI1_IGD_064A_REZN_A": "^1РЕЗНОВ: ^7Я не можу знову ризикувати...\nТепер знайти його мусиш ти. ",
 "SUBTITLE_SNI1_IGD_065A_REZN_A": "^1РЕЗНОВ: ^7Не виходь на світло. Вистрілить - міняй позицію. ",
 "SUBTITLE_SNI1_IGD_066A_REZN_B": "^1РЕЗНОВ: ^7Він тебе помітив, швидко до вікна!",
 "SUBTITLE_SNI1_IGD_067A_REZN": "^1РЕЗНОВ: ^7Знайди інше укриття!",
 "SUBTITLE_SNI1_IGD_068A_REZN": "^1РЕЗНОВ: ^7Тобі треба змінити позицію!",
 "SUBTITLE_SNI1_IGD_069A_REZN": "^1РЕЗНОВ: ^7РУШАААЙ!!!",
 "SUBTITLE_SNI1_IGD_070A_REZN_B": "^1РЕЗНОВ: ^7Вдалого полювання.",
 "SUBTITLE_SNI1_IGD_071A_REZN_B": "^1РЕЗНОВ: ^7Патрулі напевно\nпочули ці постріли.",
 "SUBTITLE_SNI1_IGD_072A_REZN": "^1РЕЗНОВ: ^7Треба рухатися.",
 "SUBTITLE_SNI1_IGD_073A_REZN_E": "^1РЕЗНОВ: ^7Тссс... Німецький патруль.",
 "SUBTITLE_SNI1_IGD_074A_REZN_A": "^1РЕЗНОВ: ^7Вони нас знайшли!",
 "SUBTITLE_SNI1_IGD_075A_REZN_B": "^1РЕЗНОВ: ^7Треба негайно йти!",
 "SUBTITLE_SNI1_IGD_076A_REZN_A": "^1РЕЗНОВ: ^7Лягай!!!",
 "SUBTITLE_SNI1_IGD_077A_REZN": "^1РЕЗНОВ: ^7Вони хочуть нас випалити!",
 "SUBTITLE_SNI1_IGD_078A_REZN": "^1РЕЗНОВ: ^7Пригнися, намагайся не дихати!",
 "SUBTITLE_SNI1_IGD_079A_REZN": "^1РЕЗНОВ: ^7Стрибай!... ВПЕРЕД!",
 "SUBTITLE_SNI1_IGD_100A_REZN_A": "^1РЕЗНОВ: ^7Роби, як я кажу, і ми\nпомстимося за цю різанину.",
 "SUBTITLE_SNI1_IGD_101A_REZN_A": "^1РЕЗНОВ: ^7Рука поранена, і я більше не можу цілитися.\nТи зробиш це за мене.",
 "SUBTITLE_SNI1_IGD_102A_REZN": "^1РЕЗНОВ: ^7Якщо люди Амзеля нас помітять,\nцей фонтан стане нашою могилою.",
 "SUBTITLE_SNI1_IGD_104A_REZN": "^1РЕЗНОВ: ^7Ти видав нашу позицію!\nТо хоч помремо в бою!",
 "SUBTITLE_SNI1_IGD_105A_REZN": "^1РЕЗНОВ: ^7НІІІ!!! Наш шанс утрачено!",
 "SUBTITLE_SNI1_IGD_108A_REZN_A": "^1РЕЗНОВ: ^7Ти видав свою позицію!",
 "SUBTITLE_SNI1_IGD_109A_REZN_A": "^1РЕЗНОВ: ^7Твої постріли показують йому, де ти!",
 "SUBTITLE_SNI1_IGD_200A_REZN": "^1РЕЗНОВ: ^7Двоє! Біля палаючої машини!",
 "SUBTITLE_SNI1_IGD_201A_REZN": "^1РЕЗНОВ: ^7Ще двоє! Біля сходів!",
 "SUBTITLE_SNI1_IGD_202A_REZN": "^1РЕЗНОВ: ^7Двоє прямо попереду!",
 "SUBTITLE_SNI1_IGD_203A_REZN": "^1РЕЗНОВ: ^7Запізно!",
 "SUBTITLE_SNI1_IGD_204A_REZN": "^1РЕЗНОВ: ^7Треба було скористатися шансом!",
 "SUBTITLE_SNI1_IGD_205A_REZN": "^1РЕЗНОВ: ^7Через тебе шанс на помсту\nвислизнув у нас крізь пальці!",
 "SUBTITLE_SNI1_IGD_206A_REZN": "^1РЕЗНОВ: ^7Ну ж бо....",
 "SUBTITLE_SNI1_IGD_207A_REZN_C": "^1РЕЗНОВ: ^7Хай пройдуть...",
 "SUBTITLE_SNI1_IGD_208A_REZN": "^1РЕЗНОВ: ^7Швидше! Поки ми не згоріли живцем!",
 "SUBTITLE_SNI1_IGD_209A_REZN_A": "^1РЕЗНОВ: ^7Вони оточують будівлю!",
 "SUBTITLE_SNI1_IGD_210A_REZN": "^1РЕЗНОВ: ^7Он!... У вікнах!",
 "SUBTITLE_SNI1_IGD_211A_REZN": "^1РЕЗНОВ: ^7Відповідай вогнем!",
 "SUBTITLE_SNI1_IGD_212A_REZN": "^1РЕЗНОВ: ^7Треба поспішати!",
 "SUBTITLE_SNI1_IGD_213A_REZN": "^1РЕЗНОВ: ^7Рушай! Нагору!",
 "SUBTITLE_SNI1_IGD_214A_REZN": "^1РЕЗНОВ: ^7Треба знайти вихід!",
 "SUBTITLE_SNI1_IGD_215A_REZN_A": "^1РЕЗНОВ: ^7Ось, друже... Хапайся за руку.",
 "SUBTITLE_SNI1_IGD_216A_REZN": "^1РЕЗНОВ: ^7Ти потрібен мені живим.",
 "SUBTITLE_SNI1_IGD_217A_REZN_A": "^1РЕЗНОВ: ^7Треба стрибати!",
 "SUBTITLE_SNI1_IGD_218A_REZN_A": "^1РЕЗНОВ: ^7Тут не можна лишатися!",
 "SUBTITLE_SNI1_IGD_300A_DALE": "^1ДАЛЕЦЬКИЙ: ^7Дмитре?",
 "SUBTITLE_SNI1_IGD_301A_DALE": "^1ДАЛЕЦЬКИЙ: ^7Ми думали, ти серед загиблих\nу різанині на площі!",
 "SUBTITLE_SNI1_IGD_302A_REZN_A": "^1РЕЗНОВ: ^7Був. Серед них, але не одним із них.",
 "SUBTITLE_SNI1_IGD_303A_DALE": "^1ДАЛЕЦЬКИЙ: ^7Ми збираємося штурмувати\nвузол зв'язку на північ звідси...",
 "SUBTITLE_SNI1_IGD_304A_REZN_A": "^1РЕЗНОВ: ^7Добре. Так німецьке командування\nне зможе покликати на допомогу.",
 "SUBTITLE_SNI1_IGD_305A_REZN_A": "^1РЕЗНОВ: ^7Ми з Дмитром прикриємо вас згори...\nЧекайте, доки не почуєте передсмертні крики німців.",
 "SUBTITLE_SNI1_IGD_306A_REZN_A": "^1РЕЗНОВ: ^7Дмитре... Сюди... Нагору драбиною.",
 "SUBTITLE_SNI1_IGD_307A_REZN": "^1РЕЗНОВ: ^7Не стріляй. Бачиш вогнеметників?",
 "SUBTITLE_SNI1_IGD_308A_REZN": "^1РЕЗНОВ: ^7Вибери слушну мить.",
 "SUBTITLE_SNI1_IGD_309A_REZN": "^1РЕЗНОВ: ^7Вибух паливного бака спопелить\nусіх, хто стоїть поруч.",
 "SUBTITLE_SNI1_IGD_310A_REZN_A": "^1РЕЗНОВ: ^7Не можна гаяти ні секунди!",
 "SUBTITLE_SNI1_IGD_311A_REZN": "^1РЕЗНОВ: ^7Стріляй, Дмитре!",
 "SUBTITLE_SNI1_IGD_312A_REZN": "^1РЕЗНОВ: ^7Швидко! Стріляй у паливний бак!!!",
 "SUBTITLE_SNI1_IGD_313A_REZN": "^1РЕЗНОВ: ^7Не проґав момент!",
 "SUBTITLE_SNI1_IGD_314A_REZN": "^1РЕЗНОВ: ^7ЗАРАЗ!!!",
 "SUBTITLE_SNI1_IGD_315A_REZN_B": "^1РЕЗНОВ: ^7Ха! Ха! Ха! Ха!",
 "SUBTITLE_SNI1_IGD_316A_REZN": "^1РЕЗНОВ: ^7Ще один вогнеметник!... Рознеси його на шматки!",
 "SUBTITLE_SNI1_IGD_317A_REZN": "^1РЕЗНОВ: ^7Прикрий вогнем наших товаришів унизу!",
 "SUBTITLE_SNI1_IGD_318A_REZN": "^1РЕЗНОВ: ^7Ще вогнеметники! Займають позиції!",
 "SUBTITLE_SNI1_IGD_319A_REZN": "^1РЕЗНОВ: ^7Ще один!",
 "SUBTITLE_SNI1_IGD_320A_REZN": "^1РЕЗНОВ: ^7Хай він згорить!!!",
 "SUBTITLE_SNI1_IGD_321A_REZN": "^1РЕЗНОВ: ^7Не припиняй вогню!",
 "SUBTITLE_SNI1_IGD_322A_REZN": "^1РЕЗНОВ: ^7Ще піхота! Коси їх!",
 "SUBTITLE_SNI1_IGD_323A_REZN_A": "^1РЕЗНОВ: ^7Кулемет у вікні другого поверху!",
 "SUBTITLE_SNI1_IGD_324A_REZN": "^1РЕЗНОВ: ^7Німецьке підкріплення!\nВиходять на лівий балкон!",
 "SUBTITLE_SNI1_IGD_325A_REZN": "^1РЕЗНОВ: ^7Ще! На верхньому балконі!",
 "SUBTITLE_SNI1_IGD_326A_REZN": "^1РЕЗНОВ: ^7Наші друзі просуваються.\nМи теж мусимо!",
 "SUBTITLE_SNI1_IGD_327A_REZN": "^1РЕЗНОВ: ^7Нагору сходами, швидко.",
 "SUBTITLE_SNI1_IGD_328A_REZN_A": "^1РЕЗНОВ: ^7Сюди!",
 "SUBTITLE_SNI1_IGD_329A_REZN": "^1РЕЗНОВ: ^7Відчуваєш, як частіше б'ється серце,\nколи ми наближаємося до здобичі?",
 "SUBTITLE_SNI1_IGD_330A_REZN_A": "^1РЕЗНОВ: ^7Скоро генерал Амзель буде в нас на прицілі.",
 "SUBTITLE_SNI1_IGD_331A_REZN": "^1РЕЗНОВ: ^7Займи позицію і прикривай вогнем!",
 "SUBTITLE_SNI1_IGD_332A_REZN": "^1РЕЗНОВ: ^7Порви цю погань на шмаття!",
 "SUBTITLE_SNI1_IGD_333A_REZN": "^1РЕЗНОВ: ^7Бронетранспортер! Знищ його кулемет!",
 "SUBTITLE_SNI1_IGD_334A_REZN": "^1РЕЗНОВ: ^7Наші захопили вузол зв'язку.\nАмзель спробує втекти.",
 "SUBTITLE_SNI1_IGD_335A_REZN": "^1РЕЗНОВ: ^7Швидко! Треба відрізати йому шлях до втечі!",
 "SUBTITLE_SNI1_IGD_336A_REZN": "^1РЕЗНОВ: ^7Дивись уперед...\nБудівля з прапорами - це німецький командний пункт...",
 "SUBTITLE_SNI1_IGD_340A_REZN": "^1РЕЗНОВ: ^7Звуки бою його виманять.",
 "SUBTITLE_SNI1_IGD_343A_REZN": "^1РЕЗНОВ: ^7Боягуз! Ось він!",
 "SUBTITLE_SNI1_IGD_344A_REZN": "^1РЕЗНОВ: ^7Не дай йому втекти.",
 "SUBTITLE_SNI1_IGD_345A_REZN": "^1РЕЗНОВ: ^7Він за вантажівкою!",
 "SUBTITLE_SNI1_IGD_345B_REZN": "^1РЕЗНОВ: ^7Амзель за вантажівкою!",
 "SUBTITLE_SNI1_IGD_345C_REZN": "^1РЕЗНОВ: ^7Покидьок ховається за вантажівкою!",
 "SUBTITLE_SNI1_IGD_346A_REZN": "^1РЕЗНОВ: ^7Він у бронетранспортері!",
 "SUBTITLE_SNI1_IGD_346B_REZN": "^1РЕЗНОВ: ^7Амзель у бронетранспортері!",
 "SUBTITLE_SNI1_IGD_346C_REZN": "^1РЕЗНОВ: ^7Покидьок у бронетранспортері!",
 "SUBTITLE_SNI1_IGD_347A_REZN": "^1РЕЗНОВ: ^7Стріляй!",
 "SUBTITLE_SNI1_IGD_348A_REZN": "^1РЕЗНОВ: ^7Убий його!",
 "SUBTITLE_SNI1_IGD_349A_REZN": "^1РЕЗНОВ: ^7Його гріхи не мають лишитися безкарними!",
 "SUBTITLE_SNI1_IGD_350A_REZN": "^1РЕЗНОВ: ^7Швидше!",
 "SUBTITLE_SNI1_IGD_353A_REZN_A": "^1РЕЗНОВ: ^7Ми завдали могутнього удару за це місто...\nза всю Росію.",
 "SUBTITLE_SNI1_IGD_355A_REZN_A": "^1РЕЗНОВ: ^7Усе зміниться, друже мій.",
 "SUBTITLE_SNI1_IGD_356A_REZN": "^1РЕЗНОВ: ^7Тікай, Дмитре!",
 "SUBTITLE_SNI1_IGD_357A_REZN": "^1РЕЗНОВ: ^7Тікай!!!!",
 "SUBTITLE_SNI1_IGD_358A_REZN": "^1РЕЗНОВ: ^7Сюди!!!",
 "SUBTITLE_SNI1_IGD_400A_REZN_C": "^1РЕЗНОВ: ^7(сміється) Ти справді влучний стрілець, Дмитре!",
 "SUBTITLE_SNI1_IGD_401A_REZN": "^1РЕЗНОВ: ^7Чудовий постріл, Дмитре!",
 "SUBTITLE_SNI1_IGD_402A_DALE": "^1ДАЛЕЦЬКИЙ: ^7Вони відступають!",
 "SUBTITLE_SNI1_IGD_403A_DALE": "^1ДАЛЕЦЬКИЙ: ^7Уперед!!!",
 "SUBTITLE_SNI1_IGD_404A_DALE": "^1ДАЛЕЦЬКИЙ: ^7В атаку!!!",
 "SUBTITLE_SNI1_IGD_405A_DALE": "^1ДАЛЕЦЬКИЙ: ^7Ура!!!",
 "SUBTITLE_SNI1_IGD_406A_REZN": "^1РЕЗНОВ: ^7Прикрий наших товаришів!",
 "SUBTITLE_SNI1_IGD_407A_REZN_A": "^1РЕЗНОВ: ^7Не припиняй вогню! Нашим унизу потрібне прикриття!",
 "SUBTITLE_SNI1_IGD_408A_REZN": "^1РЕЗНОВ: ^7Ми йому не дозволимо.",
 "SUBTITLE_SNI1_IGD_409A_REZN": "^1РЕЗНОВ: ^7Ми нічим не можемо допомогти нашим товаришам...",
 "SUBTITLE_SNI1_IGD_410A_REZN": "^1РЕЗНОВ: ^7Ми надто близько до мети, щоб видати себе.",
 "SUBTITLE_SNI1_IGD_411A_REZN": "^1РЕЗНОВ: ^7Чорт! Він не сам!",
 "SUBTITLE_SNI1_IGD_412A_REZN": "^1РЕЗНОВ: ^7Всади кулю в голову його охоронцеві!",
 "SUBTITLE_SNI1_IGD_413A_REZN": "^1РЕЗНОВ: ^7Він за танком!",
 "SUBTITLE_SNI1_IGD_413B_REZN": "^1РЕЗНОВ: ^7Амзель за танком!",
 "SUBTITLE_SNI1_IGD_413C_REZN": "^1РЕЗНОВ: ^7Покидьок за танком!",
 "SUBTITLE_SNI1_IGD_414A_REZN": "^1РЕЗНОВ: ^7За гарматою!",
 "SUBTITLE_SNI1_IGD_414B_REZN": "^1РЕЗНОВ: ^7Амзель перебрався за гармату!",
 "SUBTITLE_SNI1_IGD_414C_REZN": "^1РЕЗНОВ: ^7Покидьок за гарматою!",
 "SUBTITLE_SNI1_IGD_415A_REZN": "^1РЕЗНОВ: ^7За машиною, що димиться!",
 "SUBTITLE_SNI1_IGD_415B_REZN": "^1РЕЗНОВ: ^7Амзель за машиною, що димиться!",
 "SUBTITLE_SNI1_IGD_415C_REZN": "^1РЕЗНОВ: ^7Покидьок за машиною, що димиться!",
 "SUBTITLE_SNI1_IGD_416A_REZN_A": "^1РЕЗНОВ: ^7Він сідає в ту машину!",
 "SUBTITLE_SNI1_IGD_416B_REZN": "^1РЕЗНОВ: ^7Амзель сідає в ту машину!",
 "SUBTITLE_SNI1_IGD_416C_REZN": "^1РЕЗНОВ: ^7Покидьок сідає в ту машину!",
 "SUBTITLE_SNI1_IGD_417A_REZN": "^1РЕЗНОВ: ^7Стріляй у водія! Зупини його!",
 "SUBTITLE_SNI1_IGD_418A_REZN": "^1РЕЗНОВ: ^7(сміх)",
 "SUBTITLE_SNI1_IGD_419A_REZN": "^1РЕЗНОВ: ^7Вони прийдуть по нас! Треба йти!",
 "SUBTITLE_SNI1_IGD_420A_REZN": "^1РЕЗНОВ: ^7Швидко! Поки їхні танки не вистрілили знову!",
 "SUBTITLE_SNI1_IGD_421A_REZN": "^1РЕЗНОВ: ^7У річку, Дмитре! Це наш єдиний шанс!"
}