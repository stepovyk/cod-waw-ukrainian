 "SUBTITLE_PBY1_IGD_037A_LAUG": "^1ЛАФЛІН: ^7Ці покидьки швидкі!",
 "SUBTITLE_PBY1_IGD_037A_LAUG_SAFE": "^1ЛАФЛІН: ^7Ці тварюки швидкі!",
 "SUBTITLE_PBY1_IGD_038A_HARR": "^1ГАРРІНГТОН: ^7Просто знищ їх, і якнайшвидше.",
 "SUBTITLE_PBY1_IGD_039A_LAUG": "^1ЛАФЛІН: ^7Іди-но сюди, гнидо мала! ",
 "SUBTITLE_PBY1_IGD_039A_LAUG_SAFE": "^1ЛАФЛІН: ^7Іди-но сюди!",
 "SUBTITLE_PBY1_IGD_040A_BOOT": "^1БУТ: ^7Чорт, мало не влучили! Локу?!!!",
 "SUBTITLE_PBY1_IGD_040A_BOOT_SAFE": "^1БУТ: ^7Мало не влучили! Локу?!!!",
 "SUBTITLE_PBY1_IGD_041A_BOOT": "^1БУТ: ^7Дідько!   Скажіть, що ми не втратили стрільця!",
 "SUBTITLE_PBY1_IGD_041A_BOOT_SAFE": "^1БУТ: ^7Скажіть, що ми не втратили стрільця!",
 "SUBTITLE_PBY1_IGD_042A_LAND": "^1ЛЕНДРІ: ^7Він живий...",
 "SUBTITLE_PBY1_IGD_043A_LAUG": "^1ЛАФЛІН: ^7Лайно!!!  Хтось бачив зенітки\nпід час першого заходу?!!!",
 "SUBTITLE_PBY1_IGD_043A_LAUG_SAFE": "^1ЛАФЛІН: ^7Хтось бачив зенітки під час першого заходу?!!!",
 "SUBTITLE_PBY1_IGD_044A_BOOT": "^1БУТ: ^7Мабуть, вони везуть\nдуже важливий вантаж.",
 "SUBTITLE_PBY1_IGD_045A_LAUG": "^1ЛАФЛІН: ^7Треба пірнути під зенітний вогонь!",
 "SUBTITLE_PBY1_IGD_046A_BOOT": "^1БУТ: ^7Зрозумів...",
 "SUBTITLE_PBY1_IGD_047A_LAUG": "^1ЛАФЛІН: ^7Не можу нормально прицілитися!",
 "SUBTITLE_PBY1_IGD_048A_BOOT": "^1БУТ: ^7Знижуюся до самої води!  ",
 "SUBTITLE_PBY1_IGD_049A_BOOT": "^1БУТ: ^7Підведу нас якомога ближче...\nТреба закінчувати! Це останній захід.",
 "SUBTITLE_PBY1_IGD_050A_BOOT": "^1БУТ: ^7Клади їх.",
 "SUBTITLE_PBY1_IGD_051A_BOOT": "^1БУТ: ^7Чудова робота, Локу.",
 "SUBTITLE_PBY1_IGD_052A_BOOT": "^1БУТ: ^7Добий їх!",
 "SUBTITLE_PBY1_IGD_053A_HARR": "^1ГАРРІНГТОН: ^7Здається, ми всіх накрили.",
 "SUBTITLE_PBY1_IGD_054A_LAUG": "^1ЛАФЛІН: ^7О так... Вони йдуть на дно.",
 "SUBTITLE_PBY1_IGD_055A_BOOT": "^1БУТ: ^7Добра робота, Локу.\nТи врятував багато життів на Окінаві.",
 "SUBTITLE_PBY1_IGD_056A_LAUG": "^1ЛАФЛІН: ^7Лайно. Ми їх наче вивели з ладу,\nале вони ще на плаву.",
 "SUBTITLE_PBY1_IGD_056A_LAUG_SAFE": "^1ЛАФЛІН: ^7Ми їх наче вивели з ладу,\nале вони ще на плаву.",
 "SUBTITLE_PBY1_IGD_057A_BOOT": "^1БУТ: ^7Сумніваюся, що японці\nщось урятують...\nЗійде, Локу.",
 "SUBTITLE_PBY1_IGD_058A_BOOT": "^1БУТ: ^7Тут ми закінчили...",
 "SUBTITLE_PBY1_IGD_059A_BOOT": "^1БУТ: ^7Набирай висоту. Повертаємося на базу.",
 "SUBTITLE_PBY1_IGD_060A_HARR": "^1ГАРРІНГТОН: ^7Підтверджую.",
 "SUBTITLE_PBY1_IGD_061A_HARR": "^1ГАРРІНГТОН: ^7Нас неабияк пошарпало\nна останньому заході, Буте.",
 "SUBTITLE_PBY1_IGD_061B_HARR": "^1ГАРРІНГТОН: ^7Нас неабияк пошарпало\nна останньому заході, Манта.",
 "SUBTITLE_PBY1_IGD_062A_LAND": "^1ЛЕНДРІ: ^7Підтверджую, Гаррінгтоне...\nУ тебе димить двигун номер два.",
 "SUBTITLE_PBY1_IGD_062B_LAND": "^1ЛЕНДРІ: ^7Підтверджую, Акула-молот...\nУ тебе димить двигун номер два.",
 "SUBTITLE_PBY1_IGD_063A_HARR": "^1ГАРРІНГТОН: ^7Стрілки ще не в червоній зоні...\nМаємо дотягнути...\nЯкщо тільки знову не нарвемося\nна ворога.",
 "SUBTITLE_PBY1_IGD_064A_LAND": "^1ЛЕНДРІ: ^7О, дідько...",
 "SUBTITLE_PBY1_IGD_064A_LAND_SAFE": "^1ЛЕНДРІ: ^7Що там ще...",
 "SUBTITLE_PBY1_IGD_065A_LAND": "^1ЛЕНДРІ: ^7Капітане... Сигнал лиха...\nФлот дістав тяжкого удару.",
 "SUBTITLE_PBY1_IGD_065B_LAND": "^1ЛЕНДРІ: ^7Капітане... Сигнал лиха...\nФлот атакували на шляху до Окінави.",
 "SUBTITLE_PBY1_IGD_066A_LAND": "^1ЛЕНДРІ: ^7Авіапідтримка надто далеко...",
 "SUBTITLE_PBY1_IGD_067A_LAND": "^1ЛЕНДРІ: ^7Просять усі вільні екіпажі долучитися\nдо рятувальної операції. У воді люди...",
 "SUBTITLE_PBY1_IGD_068A_BOOT": "^1БУТ: ^7Гаразд... Локу, задрай черевний люк.\nСідаємо на воду...",
 "SUBTITLE_PBY1_IGD_069A_BOOT": "^1БУТ: ^7Заберімо наших хлопців...",
 "SUBTITLE_PBY1_IGD_070A_HARR": "^1ГАРРІНГТОН: ^7ЛАЙНО!... Чуєте?",
 "SUBTITLE_PBY1_IGD_070A_HARR_SAFE": "^1ГАРРІНГТОН: ^7Чуєте?",
 "SUBTITLE_PBY1_IGD_071A_BOOT": "^1БУТ: ^7«Зеро»!  Просто під нами!",
 "SUBTITLE_PBY1_IGD_072A_BOOT": "^1БУТ: ^7Вогонь, Локу!",
 "SUBTITLE_PBY1_IGD_073A_BOOT": "^1БУТ: ^7Збий якомога більше\nцих клятих літаків!",
 "SUBTITLE_PBY1_IGD_073A_BOOT_SAFE": "^1БУТ: ^7Збий якомога більше\nцих літаків!",
 "SUBTITLE_PBY1_IGD_074A_BOOT": "^1БУТ: ^7Зв'яжися з флотом! Передай, що Тодзьо\nлетить просто на них!",
 "SUBTITLE_PBY1_IGD_075A_HARR": "^1ГАРРІНГТОН: ^7У нас влучили!",
 "SUBTITLE_PBY1_IGD_076A_BOOT": "^1БУТ: ^7Твій двигун номер два\nпалає, як смолоскип, глуши його!  Глуши! ",
 "SUBTITLE_PBY1_IGD_077A_HARR": "^1ГАРРІНГТОН: ^7Я намагаюся! Керування, трясця, геть посічене!",
 "SUBTITLE_PBY1_IGD_077A_HARR_SAFE": "^1ГАРРІНГТОН: ^7Я намагаюся! Керування посічене!",
 "SUBTITLE_PBY1_IGD_078A_BOOT": "^1БУТ: ^7Тримайся, ГАРРІНГТОНЕ!\nТРИМАЙСЯ!",
 "SUBTITLE_PBY1_IGD_079A_HARR": "^1ГАРРІНГТОН: ^7Мейдей! Мейдей! \nПадаємо, повторюю, ми падаємо...",
 "SUBTITLE_PBY1_IGD_080A_BOOT": "^1БУТ: ^7ГАРРІНГТОНЕ!!!",
 "SUBTITLE_PBY1_IGD_081A_BOOT": "^1БУТ: ^7Гаразд, хлопці... флоту ще потрібна наша допомога...",
 "SUBTITLE_PBY1_IGD_082A_BOOT": "^1БУТ: ^7Хтось хоче відмовитися?",
 "SUBTITLE_PBY1_IGD_083A_BOOT": "^1БУТ: ^7Так я й думав...",
 "SUBTITLE_PBY1_IGD_084A_BOOT": "^1БУТ: ^7Летимо в саме пекло.\nУсім бути пильними й готовими до всього.",
 "SUBTITLE_PBY1_IGD_085A_BOOT": "^1БУТ: ^7Покидьки знищили більшість наших кораблів.",
 "SUBTITLE_PBY1_IGD_085A_BOOT_SAFE": "^1БУТ: ^7Тварюки знищили більшість наших кораблів.",
 "SUBTITLE_PBY1_IGD_086A_LAUG": "^1ЛАФЛІН: ^7Матір Божа... Думаєш, там унизу\nхтось лишився живий?",
 "SUBTITLE_PBY1_IGD_086A_LAUG_SAFE": "^1ЛАФЛІН: ^7Думаєш, там унизу\nхтось лишився живий?",
 "SUBTITLE_PBY1_IGD_087A_BOOT": "^1БУТ: ^7Бачу у воді багато постраждалих.",
 "SUBTITLE_PBY1_IGD_088A_LAUG": "^1ЛАФЛІН: ^7Лайно... Бідолахи...",
 "SUBTITLE_PBY1_IGD_088A_LAUG_SAFE": "^1ЛАФЛІН: ^7Бідні душі...",
 "SUBTITLE_PBY1_IGD_089A_LAND": "^1ЛЕНДРІ: ^7Краще б ми були не єдині,\nхто відгукнувся на сигнал лиха.\nУ нас нема місця для всіх.",
 "SUBTITLE_PBY1_IGD_090A_BOOT": "^1БУТ: ^7Зробимо, що зможемо... Сідаємо.",
 "SUBTITLE_PBY1_IGD_091A_BOOT": "^1БУТ: ^7ЛОКУ!  Будь готовий витягати людей.",
 "SUBTITLE_PBY1_IGD_092A_BOOT": "^1БУТ: ^7Ми доправимо їх додому.",
 "SUBTITLE_PBY1_IGD_093A_BOOT": "^1БУТ: ^7У воді ще наші хлопці.",
 "SUBTITLE_PBY1_IGD_094A_BOOT": "^1БУТ: ^7Бачу ще вцілілих.",
 "SUBTITLE_PBY1_IGD_095A_LAND": "^1ЛЕНДРІ: ^7Потопіть ті кляті торпедні катери!\nПоки вони не порвали наших на шмаття!",
 "SUBTITLE_PBY1_IGD_095A_LAND_SAFE": "^1ЛЕНДРІ: ^7Потопіть ті торпедні катери! \nПоки вони не порвали наших на шмаття!",
 "SUBTITLE_PBY1_IGD_096A_BOOT": "^1БУТ: ^7ЛЕТЯТЬ! ПРАВИЙ БОРТ!",
 "SUBTITLE_PBY1_IGD_097A_BOOT": "^1БУТ: ^7ЛЕТЯТЬ! ЛІВИЙ БОРТ!",
 "SUBTITLE_PBY1_IGD_098A_BOOT": "^1БУТ: ^7ВОРУШІТЬСЯ!",
 "SUBTITLE_PBY1_IGD_099A_BOOT": "^1БУТ: ^7ТОРПЕДНІ КАТЕРИ ПРОСТО НА НАС!",
 "SUBTITLE_PBY1_IGD_100A_LAND": "^1ЛЕНДРІ: ^7Треба дістатися до тих людей!",
 "SUBTITLE_PBY1_IGD_101A_BOOT": "^1БУТ: ^7Їм доведеться почекати, поки ми\nрозберемося з торпедними катерами...",
 "SUBTITLE_PBY1_IGD_102A_BOOT": "^1БУТ: ^7Мертві ми їм нічим не допоможемо!",
 "SUBTITLE_PBY1_IGD_103A_LAND": "^1ЛЕНДРІ: ^7Локу!!!",
 "SUBTITLE_PBY1_IGD_104A_LAND": "^1ЛЕНДРІ: ^7Добий їх! НЕГАЙНО! ",
 "SUBTITLE_PBY1_IGD_105A_LAND": "^1ЛЕНДРІ: ^7Швидше!!!",
 "SUBTITLE_PBY1_IGD_106A_LAND": "^1ЛЕНДРІ: ^7Ті люди довго не протримаються!!! ",
 "SUBTITLE_PBY1_IGD_107A_LAND": "^1ЛЕНДРІ: ^7Ми його втратили!!!",
 "SUBTITLE_PBY1_IGD_108A_LAND": "^1ЛЕНДРІ: ^7Маємо місце ще для одного.",
 "SUBTITLE_PBY1_IGD_109A_BOOT": "^1БУТ: ^7Треба летіти! НЕГАЙНО!",
 "SUBTITLE_PBY1_IGD_110A_USR1": "^1МАТРОС: ^7Допоможі-і-іть!!!",
 "SUBTITLE_PBY1_IGD_111A_USR2": "^1МАТРОС: ^7Я тут!!!",
 "SUBTITLE_PBY1_IGD_112A_USR3": "^1МАТРОС: ^7Допоможіть!",
 "SUBTITLE_PBY1_IGD_113A_USR1": "^1МАТРОС: ^7Дай руку!",
 "SUBTITLE_PBY1_IGD_114A_USR2": "^1МАТРОС: ^7Я зісковзую!",
 "SUBTITLE_PBY1_IGD_115A_USR3": "^1МАТРОС: ^7Я не втримаюся!!!",
 "SUBTITLE_PBY1_IGD_116A_USR1": "^1МАТРОС: ^7БУДЬ ЛА-А-АСКА!!!",
 "SUBTITLE_PBY1_IGD_117A_USR2": "^1МАТРОС: ^7Не кидайте мене!!!",
 "SUBTITLE_PBY1_IGD_118A_LAUG": "^1ЛАФЛІН: ^7Камікадзе!",
 "SUBTITLE_PBY1_IGD_119A_BOOT": "^1БУТ: ^7О, лайно!!!!",
 "SUBTITLE_PBY1_IGD_120A_BOOT": "^1БУТ: ^7Бачите ще когось у воді?",
 "SUBTITLE_PBY1_IGD_121A_HARR": "^1ГАРРІНГТОН: ^7Живих - нікого.",
 "SUBTITLE_PBY1_IGD_122A_BOOT": "^1БУТ: ^7ЧОРТ! Нас підбили!",
 "SUBTITLE_PBY1_IGD_122A_BOOT_SAFE": "^1БУТ: ^7Нас підбили!",
 "SUBTITLE_PBY1_IGD_123A_BOOT": "^1БУТ: ^7Лафліне! Перевір, чи ми не набираємо воду!",
 "SUBTITLE_PBY1_IGD_124A_LAUG": "^1ЛАФЛІН: ^7Уже роблю.",
 "SUBTITLE_PBY1_IGD_125A_BOOT": "^1БУТ: ^7Локу! Заміни його за спареним кулеметом.",
 "SUBTITLE_PBY1_IGD_126A_LAUG": "^1ЛАФЛІН: ^7Лівий борт добряче подерло, але тримаємося!",
 "SUBTITLE_PBY1_IGD_127A_BOOT": "^1БУТ: ^7«Зеро»!",
 "SUBTITLE_PBY1_IGD_128A_LAND": "^1ЛЕНДРІ: ^7Вони навколо!",
 "SUBTITLE_PBY1_IGD_129A_BOOT": "^1БУТ: ^7Не підпускай їх до решток флоту!",
 "SUBTITLE_PBY1_IGD_130A_BOOT": "^1БУТ: ^7Локу! Треба збити кілька\nцих «Зеро», перш ніж я зможу злетіти!",
 "SUBTITLE_PBY1_IGD_131A_BOOT": "^1БУТ: ^7Не відпускай гашетку. Усе залежить від тебе...",
 "SUBTITLE_PBY1_IGD_132A_LAND": "^1ЛЕНДРІ: ^7Говорить ескадрилья «Чорний кіт», VPB 54... ",
 "SUBTITLE_PBY1_IGD_132B_LAND": "^1ЛЕНДРІ: ^7Говорить ведучий ескадрильї «Чорний кіт»,\nМанта 54... ",
 "SUBTITLE_PBY1_IGD_132C_LAND": "^1ЛЕНДРІ: ^7Говорить Манта 54... ",
 "SUBTITLE_PBY1_IGD_132D_LAND": "^1ЛЕНДРІ: ^7Говорить «Чорний кіт», Манта 54... ",
 "SUBTITLE_PBY1_IGD_133A_LAND": "^1ЛЕНДРІ: ^7Флот розбито. Повторюю, флот розбито!",
 "SUBTITLE_PBY1_IGD_134A_LAND": "^1ЛЕНДРІ: ^7У воді багато постраждалих!",
 "SUBTITLE_PBY1_IGD_135A_LAND": "^1ЛЕНДРІ: ^7Нас щільно обстрілює ворожа авіація.",
 "SUBTITLE_PBY1_IGD_136A_LAND": "^1ЛЕНДРІ: ^7Просимо негайної підтримки!",
 "SUBTITLE_PBY1_IGD_137A_BOOT": "^1БУТ: ^7Лендрі! Що там з авіапідтримкою?",
 "SUBTITLE_PBY1_IGD_138A_LAND": "^1ЛЕНДРІ: ^7Рація мовчить.",
 "SUBTITLE_PBY1_IGD_139A_BOOT": "^1БУТ: ^7Пробуй далі...\nКраще молімося, щоб вони з'явилися!",
 "SUBTITLE_PBY1_IGD_140A_LAUG": "^1ЛАФЛІН: ^7Де, в біса, та підтримка?",
 "SUBTITLE_PBY1_IGD_140A_LAUG_SAFE": "^1ЛАФЛІН: ^7Де та підтримка?",
 "SUBTITLE_PBY1_IGD_141A_LAND": "^1ЛЕНДРІ: ^7Будь ласка, відповідайте!...",
 "SUBTITLE_PBY1_IGD_142A_LAND": "^1ЛЕНДРІ: ^7Ніхто не відповідає!",
 "SUBTITLE_PBY1_IGD_143A_LAUG": "^1ЛАФЛІН: ^7Лайно! Треба забиратися!",
 "SUBTITLE_PBY1_IGD_143A_LAUG_SAFE": "^1ЛАФЛІН: ^7Треба забиратися!",
 "SUBTITLE_PBY1_IGD_144A_BOOT": "^1БУТ: ^7Ще ні, Лафліне.  Ми не можемо кинути наших!",
 "SUBTITLE_PBY1_IGD_145A_LAND": "^1ЛЕНДРІ: ^7Лафліне!  Не підпускай літаки до наших людей!",
 "SUBTITLE_PBY1_IGD_146A_LAUG": "^1ЛАФЛІН: ^7Я стараюся!  Їх забагато!",
 "SUBTITLE_PBY1_IGD_147A_LAND": "^1ЛЕНДРІ: ^7Локу, витягай його!",
 "SUBTITLE_PBY1_IGD_148A_LAUG": "^1ЛАФЛІН: ^7Він його витяг?",
 "SUBTITLE_PBY1_IGD_149A_LAND": "^1ЛЕНДРІ: ^7Він у безпеці.",
 "SUBTITLE_PBY1_IGD_150A_BOOT": "^1БУТ: ^7Лендрі,  допоможи пораненим!",
 "SUBTITLE_PBY1_IGD_151A_LAND": "^1ЛЕНДРІ: ^7Уже роблю!",
 "SUBTITLE_PBY1_IGD_152A_LAND": "^1ЛЕНДРІ: ^7Усе буде добре.",
 "SUBTITLE_PBY1_IGD_153A_LAND": "^1ЛЕНДРІ: ^7Ми тебе тримаємо.",
 "SUBTITLE_PBY1_IGD_154A_BOOT": "^1БУТ: ^7Лендрі, поклади його на койку!",
 "SUBTITLE_PBY1_IGD_155A_BOOT": "^1БУТ: ^7Добра робота, Локу...\nЛендрі, як ми там?",
 "SUBTITLE_PBY1_IGD_156A_LAND": "^1ЛЕНДРІ: ^7Корпус цілий... Гвинти крутяться...\nЦього досить, щоб звідси вибратися...",
 "SUBTITLE_PBY1_IGD_157A_BOOT": "^1БУТ: ^7Гаразд... Злітаємо...",
 "SUBTITLE_PBY1_IGD_158A_BOOT": "^1БУТ: ^7Ну, як ми впоралися?",
 "SUBTITLE_PBY1_IGD_159A_LAND": "^1ЛЕНДРІ: ^7Койки заповнені...\nЗавдяки Локу маємо шістьох.",
 "SUBTITLE_PBY1_IGD_160A_LAND": "^1ЛЕНДРІ: ^7Ми підняли на борт п'ятьох...\nДобра робота, Локу.",
 "SUBTITLE_PBY1_IGD_161A_LAND": "^1ЛЕНДРІ: ^7Лок непогано впорався... Маємо чотирьох.  ",
 "SUBTITLE_PBY1_IGD_162A_LAND": "^1ЛЕНДРІ: ^7Тих клятих «Зеро» було забагато...\nВрятували тільки трьох.",
 "SUBTITLE_PBY1_IGD_162A_LAND_SAFE": "^1ЛЕНДРІ: ^7Тих «Зеро» було забагато...\nВрятували тільки трьох.",
 "SUBTITLE_PBY1_IGD_163A_LAND": "^1ЛЕНДРІ: ^7Лише двоє, і ті в поганому стані.",
 "SUBTITLE_PBY1_IGD_164A_LAND": "^1ЛЕНДРІ: ^7Тільки один... Молімося, щоб вижив.",
