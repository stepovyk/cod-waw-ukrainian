 "SUBTITLE_PEL1_IGD_203A_ROEB": "^1РОБАК: ^7Добра робота, морпіхи...\nЗбираємося біля лінії дерев!",
 "SUBTITLE_PEL1_IGD_204A_ROEB": "^1РОБАК: ^7Рухайтеся!!!",
 "SUBTITLE_PEL1_IGD_205A_POLO": "^1ПОЛОНСЬКИЙ: ^7Звідки вони лізуть?!!!",
 "SUBTITLE_PEL1_IGD_206A_ROEB": "^1РОБАК: ^7Просто рухайся!\nПотім розберемося!!",
 "SUBTITLE_PEL1_IGD_207A_POLO": "^1ПОЛОНСЬКИЙ: ^7У тунелі!",
 "SUBTITLE_PEL1_IGD_208A_POLO": "^1ПОЛОНСЬКИЙ: ^7Заходь із флангу, Міллере!\nЧерез тунелі!",
 "SUBTITLE_PEL1_IGD_209A_ROEB": "^1РОБАК: ^7Давай, Міллере! Сюди!",
 "SUBTITLE_PEL1_IGD_210A_POLO": "^1ПОЛОНСЬКИЙ: ^7Міллере!! Викликай ракетний удар\nпо тому кулеметному гнізду!",
 "SUBTITLE_PEL1_IGD_211A_POLO": "^1ПОЛОНСЬКИЙ: ^7Накрий ракетами той опорний пункт!",
 "SUBTITLE_PEL1_IGD_212A_POLO": "^1ПОЛОНСЬКИЙ: ^7Накрий ту позицію ракетами!",
 "SUBTITLE_PEL1_IGD_300A_SULL": "^1САЛЛІВАН: ^7Тримаю, Міллере! Ти цілий!",
 "SUBTITLE_PEL1_IGD_301A_SULL": "^1САЛЛІВАН: ^7План пішов коту під хвіст... Тодзьо окопався одразу за лінією дерев.",
 "SUBTITLE_PEL1_IGD_302A_SULL": "^1САЛЛІВАН: ^7Лишайся на місці й тримай рацію напоготові.",
 "SUBTITLE_PEL1_IGD_303A_USR1": "^1МОРПІХ: ^7Що, в біса, пішло не так?!",
 "SUBTITLE_PEL1_IGD_304A_USR1": "^1МОРПІХ: ^7Тут не мало бути\nніякого опору!",
 "SUBTITLE_PEL1_IGD_305A_USR2": "^1МОРПІХ: ^7Що з Джейсоном?!!!",
 "SUBTITLE_PEL1_IGD_306A_USR3": "^1МОРПІХ: ^7Не знаю!",
 "SUBTITLE_PEL1_IGD_307A_USR3": "^1МОРПІХ: ^7Здається, його амфібію підбили!",
 "SUBTITLE_PEL1_IGD_308A_USR1": "^1МОРПІХ: ^7Не висовуйся!",
 "SUBTITLE_PEL1_IGD_309A_USR1": "^1МОРПІХ: ^7Що нам робити?!!!",
 "SUBTITLE_PEL1_IGD_310A_USR3": "^1МОРПІХ: ^7Рухайся... Знайди сержанта!",
 "SUBTITLE_PEL1_IGD_311A_SULL": "^1САЛЛІВАН: ^7Ракетний удар мав\nїх добряче потріпати.",
 "SUBTITLE_PEL1_IGD_312A_SULL": "^1САЛЛІВАН: ^7Усі готові?",
 "SUBTITLE_PEL1_IGD_313A_ROEB": "^1РОБАК: ^7Міллере! Викликай ракетний удар!",
 "SUBTITLE_PEL1_IGD_314A_SULL": "^1САЛЛІВАН: ^7Підходить японське\nпідкріплення!",
 "SUBTITLE_PEL1_IGD_315A_SULL": "^1САЛЛІВАН: ^7Треба стерти цих\nпокидьків на порох!",
 "SUBTITLE_PEL1_IGD_316A_ROEB": "^1РОБАК: ^7Кулемет тут не впорається,\nМіллере!",
 "SUBTITLE_PEL1_IGD_317A_ROEB": "^1РОБАК: ^7Викликай ще один ракетний удар!\nНЕГАЙНО!",
 "SUBTITLE_PEL1_IGD_318A_ROEB": "^1РОБАК: ^7Викликай ракети!",
 "SUBTITLE_PEL1_IGD_319A_ROEB": "^1РОБАК: ^7О так, чорт забирай!",
 "SUBTITLE_PEL1_IGD_320A_SULL": "^1САЛЛІВАН: ^7Усі до мене.",
 "SUBTITLE_PEL1_IGD_800A_RADO": "^1РАДИСТ: ^7Фугасний залп, \nВейко два-п'ять, азимут 3320, дальність 2200...\nВогонь на ураження - летять!",
 "SUBTITLE_PEL1_IGD_801A_RADO": "^1РАДИСТ: ^7Ціль пристріляно... \nВогонь на ураження!",
 "SUBTITLE_PEL1_IGD_802A_RADO": "^1РАДИСТ: ^7Розрив!",
 "SUBTITLE_PEL1_IGD_803A_RADO": "^1РАДИСТ: ^7Залп, \nВейко два-п'ять, влучно... ціль знищено. \nПрипинити вогонь.",
 "SUBTITLE_PEL1_IGD_804A_RADO": "^1РАДИСТ: ^7Промах... \nДіліджент один-шість, скоригуйте вогонь!\nПовторюю, скоригуйте вогонь!",
 "SUBTITLE_PEL1_IGD_805A_RADO": "^1РАДИСТ: ^7Фугасний залп, \nВейко вісім-один, азимут 35, \nдальність 28... летять!",
 "SUBTITLE_PEL1_IGD_806A_RADO": "^1РАДИСТ: ^7Ердейл-3 бачить ваш дим\nу точці Браво Ліма шість... Айронклед, вогонь на ураження... \nЛетять!",
 "SUBTITLE_PEL1_IGD_807A_RADO": "^1РАДИСТ: ^7Вашу ракету помічено\nв квадраті Ейбл Дельта п'ять-дев'ять.\nФугасний залп впритул, уже летить!",
 "SUBTITLE_PEL1_IGD_808A_RADO": "^1РАДИСТ: ^7Коригую вогонь по вашій цілі:\nазимут 33, дальність 29... Фугасний залп впритул... \nЛетять!",
 "SUBTITLE_PEL1_IGD_809A_RADO": "^1РАДИСТ: ^7Пристрілюю вашу ціль: азимут 33, дальність 29... Фугасний залп впритул... летять!",
 "SUBTITLE_PEL1_IGD_810A_RADO": "^1РАДИСТ: ^7Ціль уражено!",
 "SUBTITLE_PEL1_IGD_811A_RADO": "^1РАДИСТ: ^7Залп по цілі.",
 "SUBTITLE_PEL1_IGD_812A_RADO": "^1РАДИСТ: ^7Припинити вогонь...\nЦіль знищено!",
 "SUBTITLE_PEL1_IGD_813A_RADO": "^1РАДИСТ: ^7Вогонь недоступний.",
 "SUBTITLE_PEL1_IGD_814A_RADO": "^1РАДИСТ: ^7Вогнева підтримка зараз недоступна.",
 "SUBTITLE_PEL1_IGD_815A_RADO": "^1РАДИСТ: ^7Наводимося на ціль.",
 "SUBTITLE_PEL1_IGD_816A_RADO": "^1РАДИСТ: ^7Наносимо ціль на карту.",
 "SUBTITLE_PEL1_IGD_817A_RADO": "^1РАДИСТ: ^7Відлік...",
