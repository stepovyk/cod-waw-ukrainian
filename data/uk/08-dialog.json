 "SUBTITLE_PEL1_IGD_828A_RADO": "^1РАДИСТ: ^75 секунд.",
 "SUBTITLE_PEL1_IGD_829A_RADO": "^1РАДИСТ: ^7Вогнева підтримка готова.\nНазвіть ціль.",
 "SUBTITLE_PEL1_IGD_830A_RADO": "^1РАДИСТ: ^7Фугасний залп доступний.",
 "SUBTITLE_PEL1_IGD_831A_RADO": "^1РАДИСТ: ^7Наведено...\nНазвіть ціль, прийом.",
 "SUBTITLE_PEL1_IGD_832A_RADO": "^1РАДИСТ: ^7Ракетний залп доступний.",
 "SUBTITLE_PEL1_IGD_833A_RADO": "^1РАДИСТ: ^7Ракетний удар із моря\nнапоготові. ",
 "SUBTITLE_PEL1_IGD_834A_RADO": "^1РАДИСТ: ^7Ракети заряджено,\nготові до пуску.",
 "SUBTITLE_PEL1_IGD_835A_RADO": "^1РАДИСТ: ^7Авіаудар доступний.",
 "SUBTITLE_PEL1_IGD_836A_RADO": "^1РАДИСТ: ^7Авіаудар напоготові. ",
 "SUBTITLE_PEL1_IGD_837A_RADO": "^1РАДИСТ: ^7Авіаудар підготовлено,\nлітаки готові атакувати.",
 "SUBTITLE_PEL1_IGD_838A_RADO": "^1РАДИСТ: ^7Чекаю на координати цілі.",
 "SUBTITLE_PEL1_IGD_839A_RADO": "^1РАДИСТ: ^7Передайте координати.",
 "SUBTITLE_PEL1_IGD_840A_RADO": "^1РАДИСТ: ^7Прийнято.",
 "SUBTITLE_PEL1_IGD_841A_RADO": "^1РАДИСТ: ^7Координати отримано.",
 "SUBTITLE_PEL1_IGD_842A_RADO": "^1РАДИСТ: ^7Відкриваємо вогонь.",
 "SUBTITLE_PEL1_IGD_843A_RADO": "^1РАДИСТ: ^7Підтримка недоступна.",
 "SUBTITLE_PEL1_IGD_844A_RADO": "^1РАДИСТ: ^7За цими координатами\nвогню не буде. Перевірте дані.",
 "SUBTITLE_PEL1_IGD_845A_RADO": "^1РАДИСТ: ^7Підтверджую.",
 "SUBTITLE_PEL1_INT_000A_SULL": "^1САЛЛІВАН: ^7Пора.",
 "SUBTITLE_PEL1_INT_001B_ROEB": "^1РОБАК: ^7Удачі... Усім вам.",
 "SUBTITLE_PEL1_INT_002A_ROEB_A": "^1РОБАК: ^7Ну, почалося, Міллере.",
 "SUBTITLE_PEL1_INT_003A_SULL": "^1САЛЛІВАН: ^7Флот два дні поспіль рівняє острів із землею.",
 "SUBTITLE_PEL1_INT_003A_SULL_SAFE": "^1САЛЛІВАН: ^7Флот два дні поспіль бомбить острів.",
 "SUBTITLE_PEL1_INT_004A_SULL": "^1САЛЛІВАН: ^7Гаразд... Тримаймося разом,\nі за три дні впораємося.",
 "SUBTITLE_PEL1_INT_005A_ROEB_A": "^1РОБАК: ^7Тримайтеся.",
 "SUBTITLE_PEL1_INT_006A_ROEB": "^1РОБАК: ^7Ось і вони...",
 "SUBTITLE_PEL1_INT_007A_SULL": "^1САЛЛІВАН: ^7Міллере! Якщо на пляжі буде опір,\nхапай рацію й негайно викликай\nракетну підтримку!",
 "SUBTITLE_PEL1_INT_008A_SULL": "^1САЛЛІВАН: ^7Робаку, ти маєш якнайшвидше\nпройти пляж і вийти до лінії дерев. \nКоли підемо вглиб, ти йдеш першим.",
 "SUBTITLE_PEL1_INT_009A_ROEB_A": "^1РОБАК: ^7Зрозумів.",
 "SUBTITLE_PEL1_INT_010A_PSOU": "^1МОРПІХ: ^7Якого біса?!!!",
 "SUBTITLE_PEL1_INT_010A_PSOU_SAFE": "^1МОРПІХ: ^7Що за...!!!!",
 "SUBTITLE_PEL1_INT_011A_ROEB_A": "^1РОБАК: ^7ТРЯСЦЯ! Східний гребінь! На мисі Пойнт 200-мм гармата!",
 "SUBTITLE_PEL1_INT_011A_ROEB_SAFE": "^1РОБАК: ^7Східний гребінь!... На мисі Пойнт 200-мм гармата!",
 "SUBTITLE_PEL1_INT_012A_PSOU": "^1МОРПІХ: ^7Ще одну амфібію підбили!",
 "SUBTITLE_PEL1_INT_013A_SULL": "^1САЛЛІВАН: ^7Тримайся, морпіху.",
 "SUBTITLE_PEL1_INT_014A_ROEB_A": "^1РОБАК: ^7Голови вниз!",
 "SUBTITLE_PEL1_INT_015A_LVTD": "^1МОРПІХ: ^720 секунд!",
 "SUBTITLE_PEL1_INT_016A_SULL": "^1САЛЛІВАН: ^7Тримайся, малий.",
 "SUBTITLE_PEL1_INT_017A_POLO": "^1ПОЛОНСЬКИЙ: ^7Треба вибиратися з цієї штуки!",
 "SUBTITLE_PEL1_INT_018A_POLO": "^1ПОЛОНСЬКИЙ: ^7А, лайно!",
 "SUBTITLE_PEL1_INT_018A_POLO_SAFE_A": "^1ПОЛОНСЬКИЙ: ^7О ні!",
 "SUBTITLE_PEL1_INT_019A_SULL": "^1САЛЛІВАН: ^7Водію, опускай рампу! Гармата от-от нас накриє.",
 "SUBTITLE_PEL1_INT_020A_PSOU": "^1МОРПІХ: ^7Це корал. Ми застрягли на...",
 "SUBTITLE_PEL1_INT_021A_ROEB": "^1РОБАК: ^7Опускай рампу!",
 "SUBTITLE_PEL1_INT_021A_SULL": "^1САЛЛІВАН: ^7Опускай рампу!",
 "SUBTITLE_PEL1_INT_100A_ROEB": "^1РОБАК: ^7Не вагайся.",
 "SUBTITLE_PEL1_INT_101A_POLO": "^1ПОЛОНСЬКИЙ: ^7Це наші були?!!",
 "SUBTITLE_PEL1_INT_102A_SULL": "^1САЛЛІВАН: ^7Усім! Не... висовувати... голови! Чуєте мене?",
 "SUBTITLE_PEL1_INT_103A_USR2": "^1МОРПІХ: ^7Господь - мій Пастир, нічого мені не забракне. Він дає мені спочити на зелених пасовиськах, водить мене до тихих вод. Він душу мою відновлює, веде мене стежками праведності заради Імені Свого. Навіть коли піду долиною смертної тіні, не боятимусь зла, бо Ти зі мною; Твій жезл і Твоя палиця - вони мене втішають. Ти готуєш переді мною трапезу на очах моїх ворогів; Ти помазуєш олією мою голову; чаша моя переповнена. Тож добро й милість супроводжуватимуть мене всі дні мого життя, і я перебуватиму в домі Господньому повіки.",
 "SUBTITLE_PEL1_INT_104A_SULL": "^1САЛЛІВАН: ^7УСІ! За борт! НЕГАЙНО!",
 "SUBTITLE_PEL1_INT_200A_ROEB": "^1РОБАК: ^7Покидьки й не зрозуміють, що їх накрило.",
 "SUBTITLE_PEL1_INT_200A_ROEB_SAFE": "^1РОБАК: ^7Звірі й не зрозуміють, що їх накрило.",
 "SUBTITLE_PEL1_OUT_000B_SULL": "^1САЛЛІВАН: ^7Убезпечте околиці...",
 "SUBTITLE_PEL1_OUT_001B_SULL": "^1САЛЛІВАН: ^7Чекайте на накази майора...",
 "SUBTITLE_PEL1_OUT_004A_POLO": "^1ПОЛОНСЬКИЙ: ^7Коли вже відпочинок?",
 "SUBTITLE_PEL1_OUT_006B_ROEB": "^1РОБАК: ^7НІ-І-І!!!",
 "SUBTITLE_PEL1_OUT_007A_ROEB": "^1РОБАК: ^7САНІТАРА!!!!",
 "SUBTITLE_PEL1_OUT_007B_ROEB": "^1РОБАК: ^7САНІТАРЕ!!!",
 "SUBTITLE_PEL1_OUT_008A_POLO": "^1ПОЛОНСЬКИЙ: ^7О-о-ох....ні....ні....ні.",
 "SUBTITLE_PEL1_OUT_100A_SULL": "^1САЛЛІВАН: ^7Скоро, Полонський... Скоро.",
 "SUBTITLE_PEL1_OUT_200A_ROEB": "^1РОБАК: ^7Що тепер, сержанте?",
 "SUBTITLE_PEL1_OUT_201A_USR1": "^1МОРПІХ: ^7А-А-А-А-А!!",
 "SUBTITLE_PEL1_OUT_202A_ROEB": "^1РОБАК: ^7Салліване! Ні... Тримайся...\nВсе буде добре... САНІТАРА!!!",
 "SUBTITLE_PEL1_OUT_202B_ROEB": "^1РОБАК: ^7Салліване! Ні... Тримайся...\nВсе буде добре... САНІТАРЕ!!!",
 "SUBTITLE_PEL2_IGD_000B_POLO": "^1ПОЛОНСЬКИЙ: ^7Ну, і що тепер?",
 "SUBTITLE_PEL2_IGD_001B_ROEB": "^1РОБАК: ^7Прямий шлях веде просто під японські гармати.",
 "SUBTITLE_PEL2_IGD_003B_ROEB": "^1РОБАК: ^7Підемо флангом.\nМоже, й змокнемо, зате живі лишимося. \nЗа болотом з'єднаємося з 5-м полком.",
 "SUBTITLE_PEL2_IGD_004B_ROEB": "^1РОБАК: ^7Будьте пильні.",
 "SUBTITLE_PEL2_IGD_005A_PGRI": "^1МОРПІХ: ^7СЕРЖАНТЕ! Тут збитий «Корсар».",
 "SUBTITLE_PEL2_IGD_006A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Бідолаху, мабуть,\nзбили сьогодні вранці.",
 "SUBTITLE_PEL2_IGD_006A_POLO_SAFE": "^1ПОЛОНСЬКИЙ: ^7Його, мабуть, збили\nсьогодні вранці.",
 "SUBTITLE_PEL2_IGD_007A_ROEB": "^1РОБАК: ^7Міллере, фюзеляж ще димить...\nПошукай уцілілих.",
 "SUBTITLE_PEL2_IGD_007B_ROEB": "^1РОБАК: ^7Фюзеляж ще димить...\nПошукай уцілілих.",
 "SUBTITLE_PEL2_IGD_008A_PGRI": "^1МОРПІХ: ^7Він у щось геть заплутався...",
 "SUBTITLE_PEL2_IGD_009A_PGRI": "^1МОРПІХ: ^7Лайно! Гранати!",
 "SUBTITLE_PEL2_IGD_009A_PGRI_SAFE": "^1МОРПІХ: ^7Гранати, тікай зві...",
 "SUBTITLE_PEL2_IGD_010A_POLO": "^1ПОЛОНСЬКИЙ: ^7ЛАЙНО!!!!",
 "SUBTITLE_PEL2_IGD_011A_ROEB_A": "^1РОБАК: ^7ЗАСІДКА!!!",
 "SUBTITLE_PEL2_IGD_012A_ROEB": "^1РОБАК: ^7Усі цілі?",
 "SUBTITLE_PEL2_IGD_013A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Покидьки мало нас не дістали...",
 "SUBTITLE_PEL2_IGD_013A_POLO_SAFE": "^1ПОЛОНСЬКИЙ: ^7Вони мало нас не дістали...",
 "SUBTITLE_PEL2_IGD_014A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Не віриться, що вони мінують наших мертвих...",
 "SUBTITLE_PEL2_IGD_015A_ROEB_A": "^1РОБАК: ^7Вони підуть на що завгодно.",
 "SUBTITLE_PEL2_IGD_016A_ROEB_A": "^1РОБАК: ^7Дивіться й слухайте.",
 "SUBTITLE_PEL2_IGD_017A_POLO_C": "^1ПОЛОНСЬКИЙ: ^7Здається, ми трохи запізнилися.\nСхоже, 5-й полк уже дає їм прочухана.",
 "SUBTITLE_PEL2_IGD_017A_POLO_SAFE": "^1ПОЛОНСЬКИЙ: ^7Здається, ми трохи запізнилися.\nСхоже, 5-й полк уже б'ється!",
 "SUBTITLE_PEL2_IGD_018A_ROEB_A": "^1РОБАК: ^7Попереду кулемети в бункерах.\nА просто перед ними - артилерія Nambu.",
 "SUBTITLE_PEL2_IGD_019A_ROEB": "^1РОБАК: ^7Рядовий! Закинь туди гранату!",
 "SUBTITLE_PEL2_IGD_020A_ROEB": "^1РОБАК: ^7Усі! Рухайтеся!",
 "SUBTITLE_PEL2_IGD_021A_ROEB": "^1РОБАК: ^7Уперед! ВПЕРЕД!",
 "SUBTITLE_PEL2_IGD_022A_ROEB": "^1РОБАК: ^7Знищте ті кулемети!!!",
 "SUBTITLE_PEL2_IGD_023A_ROEB": "^1РОБАК: ^7Мені потрібні люди на обох флангах!",
 "SUBTITLE_PEL2_IGD_024A_ROEB": "^1РОБАК: ^7Прорубайте шлях.",
 "SUBTITLE_PEL2_IGD_025A_POLO": "^1ПОЛОНСЬКИЙ: ^7Вогнеметники висуваються.",
 "SUBTITLE_PEL2_IGD_026A_ROEB": "^1РОБАК: ^7Полонський! Прикрий їх вогнем!",
 "SUBTITLE_PEL2_IGD_027A_ROEB": "^1РОБАК: ^7Не відпускайте їх!",
 "SUBTITLE_PEL2_IGD_028A_ROEB": "^1РОБАК: ^7Усі! До мене!",
 "SUBTITLE_PEL2_IGD_029A_ROEB": "^1РОБАК: ^7Придушіть вогнем ті кулемети!\nВогнеметники мають дістатися бункерів.",
 "SUBTITLE_PEL2_IGD_030A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7О так! Горіть, гаденята!",
 "SUBTITLE_PEL2_IGD_030A_POLO_SAFE": "^1ПОЛОНСЬКИЙ: ^7Так! Горіть!",
 "SUBTITLE_PEL2_IGD_031A_ROEB": "^1РОБАК: ^7Гаразд. Уперед!",
 "SUBTITLE_PEL2_IGD_032A_ROEB": "^1РОБАК: ^7Добра робота, морпіхи.",
 "SUBTITLE_PEL2_IGD_033A_ROEB": "^1РОБАК: ^7Тримайтеся купи.\nАеродром десь за пів милі на північ.",
 "SUBTITLE_PEL2_IGD_034A_ROEB": "^1РОБАК: ^7ЧОРТ ЗАБИРАЙ!!!",
 "SUBTITLE_PEL2_IGD_035A_POLO": "^1ПОЛОНСЬКИЙ: ^7Вони в траві!",
 "SUBTITLE_PEL2_IGD_036A_ROEB": "^1РОБАК: ^7Звідусіль!",
 "SUBTITLE_PEL2_IGD_037A_ROEB": "^1РОБАК: ^7Тримайтеся купи!",
 "SUBTITLE_PEL2_IGD_038A_ROEB": "^1РОБАК: ^7Стримуйте їх! Стримуйте!!!",
 "SUBTITLE_PEL2_IGD_039A_ROEB": "^1РОБАК: ^7Ворог засів у тій будівлі.",
 "SUBTITLE_PEL2_IGD_040A_ROEB_A": "^1РОБАК: ^7Що тут у вас?",
 "SUBTITLE_PEL2_IGD_041A_PLOG": "^1МОРПІХ: ^77-й полк зайшов із півночі!",
 "SUBTITLE_PEL2_IGD_042A_PGAS": "^1МОРПІХ: ^7Вони пробують вивести танки\nна аеродром, але там справжнє пекло.",
 "SUBTITLE_PEL2_IGD_043A_PLOG": "^1МОРПІХ: ^7Тодзьо міцно тримається!\nНас притиснув кулеметний вогонь\nіз другого поверху.",
 "SUBTITLE_PEL2_IGD_044A_PGAS": "^1МОРПІХ: ^7Є ідеї, сержанте?",
 "SUBTITLE_PEL2_IGD_045A_ROEB_A": "^1РОБАК: ^7Є...",
 "SUBTITLE_PEL2_IGD_046A_ROEB": "^1РОБАК: ^7Прямо попереду вантажівка з припасами.",
 "SUBTITLE_PEL2_IGD_047A_ROEB": "^1РОБАК: ^7Міллере. Полонський. За мною.",
 "SUBTITLE_PEL2_IGD_048A_ROEB": "^1РОБАК: ^7Міллере! Набери рушничних гранат\nі збий ту кляту пташку з жердини.",
 "SUBTITLE_PEL2_IGD_048A_ROEB_SAFE": "^1РОБАК: ^7Міллере! Набери рушничних гранат\nі збий ту пташку з жердини.",
 "SUBTITLE_PEL2_IGD_049A_POLO_B": "^1ПОЛОНСЬКИЙ: ^7О так, чорт забирай!",
 "SUBTITLE_PEL2_IGD_049A_POLO_SAFE": "^1ПОЛОНСЬКИЙ: ^7О так!",
 "SUBTITLE_PEL2_IGD_050A_ROEB_A": "^1РОБАК: ^7Рухайтеся! У будівлю!",
 "SUBTITLE_PEL2_IGD_051A_ROEB": "^1РОБАК: ^7Не дайте їм перегрупуватися!",
 "SUBTITLE_PEL2_IGD_052A_ROEB": "^1РОБАК: ^7Вичистіть їх!",
 "SUBTITLE_PEL2_IGD_053A_ROEB_A": "^1РОБАК: ^7Ми майже на місці. Тримайтеся купи!",
 "SUBTITLE_PEL2_IGD_054A_ROEB_A": "^1РОБАК: ^7Останній ривок - і аеродром наш!",
 "SUBTITLE_PEL2_IGD_055A_POLO": "^1ПОЛОНСЬКИЙ: ^7Чорт! Легко не буде.",
 "SUBTITLE_PEL2_IGD_055A_POLO_SAFE": "^1ПОЛОНСЬКИЙ: ^7Легко не буде.",
 "SUBTITLE_PEL2_IGD_056A_ROEB_A": "^1РОБАК: ^7Легко ніколи не буває... Але ми впораємося,\nПолонський, чуєш?",
 "SUBTITLE_PEL2_IGD_057A_ROEB": "^1РОБАК: ^7Рухайтеся!",
 "SUBTITLE_PEL2_IGD_058A_ROEB": "^1РОБАК: ^7Тримайтеся наших танків!",
 "SUBTITLE_PEL2_IGD_059A_ROEB": "^1РОБАК: ^7Допоможіть їм прорватися!",
 "SUBTITLE_PEL2_IGD_060A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Японські зенітки пристрілялися\nпо наших літаках!",
 "SUBTITLE_PEL2_IGD_061A_ROEB": "^1РОБАК: ^7Доберемося й до них!...\nСпершу треба розібратися з їхніми танками!",
 "SUBTITLE_PEL2_IGD_062A_ROEB": "^1РОБАК: ^7Збирайте припаси в окопах!",
 "SUBTITLE_PEL2_IGD_063A_ROEB": "^1РОБАК: ^7Базуки, рушничні гранати!\nБийте їх усім, що є!",
 "SUBTITLE_PEL2_IGD_065A_ROEB": "^1РОБАК: ^7Один готовий! Так тримати, Міллере!",
 "SUBTITLE_PEL2_IGD_066A_POLO": "^1ПОЛОНСЬКИЙ: ^7Так!!!",
 "SUBTITLE_PEL2_IGD_068A_ROEB": "^1РОБАК: ^7Не зупиняйся, ми майже прорвалися!",
 "SUBTITLE_PEL2_IGD_069A_ROEB": "^1РОБАК: ^7Бісово добра робота, Міллере!",
 "SUBTITLE_PEL2_IGD_069A_ROEB_SAFE": "^1РОБАК: ^7Добра робота, Міллере!",
 "SUBTITLE_PEL2_IGD_070A_ROEB": "^1РОБАК: ^7Зачистіть окопи!",
 "SUBTITLE_PEL2_IGD_071A_ROEB": "^1РОБАК: ^7Уперед, знищте зенітки!",
 "SUBTITLE_PEL2_IGD_072A_ROEB": "^1РОБАК: ^7Сьогодні цей аеродром буде наш!",
 "SUBTITLE_PEL2_IGD_073A_ROEB": "^1РОБАК: ^7Міллере! Знищ першу обслугу!",
 "SUBTITLE_PEL2_IGD_074A_POLO": "^1ПОЛОНСЬКИЙ: ^7Знищено!",
 "SUBTITLE_PEL2_IGD_075A_ROEB": "^1РОБАК: ^7Ще три!!!... Не зупиняйтеся!",
 "SUBTITLE_PEL2_IGD_076A_POLO": "^1ПОЛОНСЬКИЙ: ^7Другій обслузі кінець! ",
 "SUBTITLE_PEL2_IGD_077A_ROEB": "^1РОБАК: ^7Тримайтеся!... Ми майже на місці!",
 "SUBTITLE_PEL2_IGD_078A_ROEB": "^1РОБАК: ^7Ще дві!... ВПЕРЕД!",
 "SUBTITLE_PEL2_IGD_079A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Вони вибули з гри!",
 "SUBTITLE_PEL2_IGD_080A_ROEB": "^1РОБАК: ^7Знищ останню,\nпоки ми не втратили ще пташок!",
 "SUBTITLE_PEL2_IGD_081A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7На добраніч!!!",
 "SUBTITLE_PEL2_IGD_082A_ROEB": "^1РОБАК: ^7Чудова робота, морпіхи!",
 "SUBTITLE_PEL2_IGD_083B_ROEB": "^1РОБАК: ^7Порадуймо майора Гордона\nдоброю новиною.",
 "SUBTITLE_PEL2_IGD_100A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Лайно!",
 "SUBTITLE_PEL2_IGD_101A_POLO_A": "^1ПОЛОНСЬКИЙ: ^7Їх ще більше!",
 "SUBTITLE_PEL2_IGD_102A_ROEB": "^1РОБАК: ^7Снайпер на дереві! ",
 "SUBTITLE_PEL2_IGD_103A_PGAT": "^1МОРПІХ: ^7Кладіть їх!",
 "SUBTITLE_PEL2_IGD_104B_POLO": "^1ПОЛОНСЬКИЙ: ^7Знову клята засідка!",
 "SUBTITLE_PEL2_IGD_105A_PFOR": "^1МОРПІХ: ^7Робаку, вони в траві!",
 "SUBTITLE_PEL2_IGD_106A_POLO": "^1ПОЛОНСЬКИЙ: ^7Он там, на дереві!",
 "SUBTITLE_PEL2_IGD_107A_PGAT": "^1МОРПІХ: ^7ЛАЙНО!!",
 "SUBTITLE_PEL2_IGD_108A_ROEB": "^1РОБАК: ^7Он там.",
 "SUBTITLE_PEL2_IGD_109A_PHIL": "^1МОРПІХ: ^7На дереві, он на дереві!",
 "SUBTITLE_PEL2_IGD_110B_POLO": "^1ПОЛОНСЬКИЙ: ^7Схоже, замок не такий уже й покинутий...",
 "SUBTITLE_PEL2_IGD_112A_PHIL": "^1МОРПІХ: ^7Вони просто чекали на нас...",
 "SUBTITLE_PEL2_IGD_200A_ROEB": "^1РОБАК: ^7Міллере, бери вогнемет і доведи справу до кінця!",
 "SUBTITLE_PEL2_IGD_201A_ROEB": "^1РОБАК: ^7Спали ті кулемети! Не зупиняйся!",
 "SUBTITLE_PEL2_IGD_301A_PFOR": "^1МОРПІХ: ^7Ох, лайно...\nПокидьки збили ще одного.",
 "SUBTITLE_PEL2_IGD_301A_PFOR_SAFE": "^1МОРПІХ: ^7Вони збили ще одного!",
 "SUBTITLE_PEL2_IGD_302A_ROEB": "^1РОБАК: ^7Тим паче треба тиснути далі.\nКожен втрачений літак ускладнює нам роботу."
}