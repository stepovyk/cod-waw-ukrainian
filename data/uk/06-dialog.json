 "SUBTITLE_BER1_IGD_069A_COMM": "^1КОМІСАР: ^7УРА!",
 "SUBTITLE_BER1_IGD_100A_REZN": "^1РЕЗНОВ: ^7Прорвіть їхню лінію!",
 "SUBTITLE_BER1_IGD_101A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Рухайтеся, свині!",
 "SUBTITLE_BER1_IGD_102A_RUR2": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Пішов!",
 "SUBTITLE_BER1_IGD_103A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Обернися...",
 "SUBTITLE_BER1_IGD_104A_RUR3": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Подивіться нам у вічі, боягузи!",
 "SUBTITLE_BER1_IGD_200A_REZN": "^1РЕЗНОВ: ^7Вдалого полювання!",
 "SUBTITLE_BER1_IGD_201A_REZN": "^1РЕЗНОВ: ^7Рушаймо!",
 "SUBTITLE_BER1_IGD_300A_REZN": "^1РЕЗНОВ: ^7Дмитре! Бери дробовик!",
