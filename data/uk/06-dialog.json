 "SUBTITLE_BER2_IGD_022A_REZN_A": "^1РЕЗНОВ: ^7Ще йдуть!",
 "SUBTITLE_BER2_IGD_023A_REZN_A": "^1РЕЗНОВ: ^7Бачу їх!",
 "SUBTITLE_BER2_IGD_024A_REZN_B": "^1РЕЗНОВ: ^7Косіть їх!",
 "SUBTITLE_BER2_IGD_025A_REZN_A": "^1РЕЗНОВ: ^7Вогонь!",
 "SUBTITLE_BER2_IGD_026A_REZN": "^1РЕЗНОВ: ^7Убийте їх усіх!",
 "SUBTITLE_BER2_IGD_027A_REZN_A": "^1РЕЗНОВ: ^7Не зупинятися!",
 "SUBTITLE_BER2_IGD_028A_REZN": "^1РЕЗНОВ: ^7Кімната чиста!",
 "SUBTITLE_BER2_IGD_029A_REZN": "^1РЕЗНОВ: ^7Далі!",
 "SUBTITLE_BER2_IGD_030A_REZN": "^1РЕЗНОВ: ^7Будьте напоготові...\nВони можуть тремтіти десь у темряві.",
 "SUBTITLE_BER2_IGD_031A_REZN": "^1РЕЗНОВ: ^7Уперед, стежте за кожним кутом.",
