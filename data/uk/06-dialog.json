 "SUBTITLE_BER2_IGD_039A_REZN_A": "^1РЕЗНОВ: ^7Бережіть голови.",
 "SUBTITLE_BER2_IGD_040A_CHER": "^1ЧЕРНОВ: ^7Будинок валиться на нас!",
 "SUBTITLE_BER2_IGD_041A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Обережно!",
