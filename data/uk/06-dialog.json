 "SUBTITLE_BER2_IGD_069A_REZN": "^1РЕЗНОВ: ^7Смерть буває лише двох видів:\nшвидка або повільна.",
 "SUBTITLE_BER2_IGD_070A_REZN": "^1РЕЗНОВ: ^7Чернове, повчися в Дмитра...\nВін розуміє, що таке вбивство з милосердя.",
 "SUBTITLE_BER2_IGD_071A_REZN_A": "^1РЕЗНОВ: ^7Треба було їх застрелити, Чернове.\nЗатягувати муки звіра - жорстоко.",
 "SUBTITLE_BER2_IGD_072A_CHER": "^1ЧЕРНОВ: ^7Катюші!",
 "SUBTITLE_BER2_IGD_073A_REZN_ALT": "^1РЕЗНОВ: ^7Швидко, в метро!",
 "SUBTITLE_BER2_IGD_074A_REZN_A": "^1РЕЗНОВ: ^7Сюди!",
 "SUBTITLE_BER2_IGD_075A_REZN": "^1РЕЗНОВ: ^7Рухайтеся.",
 "SUBTITLE_BER2_IGD_076A_REZN": "^1РЕЗНОВ: ^7Сюди!",
 "SUBTITLE_BER2_IGD_077A_REZN_B": "^1РЕЗНОВ: ^7Спускайтеся сюди!",
 "SUBTITLE_BER2_IGD_078A_REZN_A": "^1РЕЗНОВ: ^7Швидше!",
 "SUBTITLE_BER2_IGD_079A_REZN": "^1РЕЗНОВ: ^7Ми не втримаємо ворота відчиненими!",
 "SUBTITLE_BER2_IGD_080A_REZN": "^1РЕЗНОВ: ^7Розділімося. Прикрийте обидві платформи.",
 "SUBTITLE_BER2_IGD_081A_REZN": "^1РЕЗНОВ: ^7Тс-с-с!",
 "SUBTITLE_BER2_IGD_082A_REZN_B": "^1РЕЗНОВ: ^7Залишайтеся на місці.",
 "SUBTITLE_BER2_IGD_083A_REZN": "^1РЕЗНОВ: ^7Дайте очам хвильку\nзвикнути до темряви.",
 "SUBTITLE_BER2_IGD_084A_REZN": "^1РЕЗНОВ: ^7ВОГОНЬ!!!",
 "SUBTITLE_BER2_IGD_085A_REZN": "^1РЕЗНОВ: ^7Там! На платформі!",
 "SUBTITLE_BER2_IGD_086A_REZN": "^1РЕЗНОВ: ^7У вагонах!",
 "SUBTITLE_BER2_IGD_087A_REZN": "^1РЕЗНОВ: ^7Тут усе валиться.",
