 "SUBTITLE_BER2_IGD_001A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Він благає пощади!",
 "SUBTITLE_BER2_IGD_003A_RUR2": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Пф-ф-ф...",
