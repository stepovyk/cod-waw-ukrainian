 "SUBTITLE_BER2_IGD_057A_REZN": "^1РЕЗНОВ: ^7Ми майже на вулиці!",
 "SUBTITLE_BER2_IGD_058A_REZN": "^1РЕЗНОВ: ^7Поки війна скінчиться,\nвід Берліна лишаться руїни.",
 "SUBTITLE_BER2_IGD_060A_REZN": "^1РЕЗНОВ: ^7Кулемети попереду! Третій поверх!",
 "SUBTITLE_BER2_IGD_061A_REZN_A": "^1РЕЗНОВ: ^7Тримайтеся танків!",
 "SUBTITLE_BER2_IGD_062A_REZN": "^1РЕЗНОВ: ^7Не зупинятися...",
 "SUBTITLE_BER2_IGD_063A_REZN_B": "^1РЕЗНОВ: ^7Переконайтеся, що всі мертві.",
 "SUBTITLE_BER2_IGD_064A_REZN": "^1РЕЗНОВ: ^7Убийте всіх.",
 "SUBTITLE_BER2_IGD_065A_REZN_A": "^1РЕЗНОВ: ^7Змітіть цю наволоч з вулиць.",
 "SUBTITLE_BER2_IGD_066A_REZN_B": "^1РЕЗНОВ: ^7Чернове! Що тут діється?",
 "SUBTITLE_BER2_IGD_067A_CHER": "^1ЧЕРНОВ: ^7Ці люди хочуть здатися.",
