 "SUBTITLE_BER1_IGD_023A_REZN": "^1РЕЗНОВ: ^7Вони слабнуть!",
 "SUBTITLE_BER1_IGD_024A_REZN": "^1РЕЗНОВ: ^7Швидше, Дмитре!",
