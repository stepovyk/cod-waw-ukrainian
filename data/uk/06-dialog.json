 "SUBTITLE_BER2_IGD_033A_REZN": "^1РЕЗНОВ: ^7Рухайтеся!",
 "SUBTITLE_BER2_IGD_034A_RUR1": "^1РАДЯНСЬКИЙ СОЛДАТ: ^7Убивши мене, ти не врятуєшся.\nМої товариші не знають жалю.",
