 "SUBTITLE_BER1_IGD_046A_REZN": "^1РЕЗНОВ: ^7Не зупинятися! Убивайте!",
 "SUBTITLE_BER1_IGD_047A_REZN": "^1РЕЗНОВ: ^7Сюди, нагору.",
 "SUBTITLE_BER1_IGD_048A_REZN": "^1РЕЗНОВ: ^7Дмитре! Бери кулемет!",
