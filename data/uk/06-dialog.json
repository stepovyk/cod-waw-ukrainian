 "SUBTITLE_BER1_IGD_054A_REZN": "^1РЕЗНОВ: ^7Кулемет тримає коридор!",
 "SUBTITLE_BER1_IGD_055A_REZN": "^1РЕЗНОВ: ^7Дмитре, знищ його!",
 "SUBTITLE_BER1_IGD_056A_REZN": "^1РЕЗНОВ: ^7Тс-с-с...",
 "SUBTITLE_BER1_IGD_057A_CHER_A": "^1ЧЕРНОВ: ^7Чуєте щось?",
 "SUBTITLE_BER1_IGD_058A_REZN": "^1РЕЗНОВ: ^7Ні...",
 "SUBTITLE_BER1_IGD_059A_REZN": "^1РЕЗНОВ: ^7Тому мені й підозріло...",
 "SUBTITLE_BER1_IGD_060A_REZN": "^1РЕЗНОВ: ^7Обережно, товариші...",
 "SUBTITLE_BER1_IGD_061A_REZN": "^1РЕЗНОВ: ^7Товариші... Наші танки наступають!",
 "SUBTITLE_BER1_IGD_062A_COMM": "^1КОМІСАР: ^7Треба донести до них наше слово...",
 "SUBTITLE_BER1_IGD_063A_COMM": "^1КОМІСАР: ^7Громадяни Берліна! Сталеве кільце\nоточує ваше прогниле місто!",
 "SUBTITLE_BER1_IGD_064A_COMM": "^1КОМІСАР: ^7Ми розчавимо всіх, хто посміє\nопиратися волі Червоної армії!",
