 "SUBTITLE_BER2_IGD_046A_REZN": "^1РЕЗНОВ: ^7Атакувати в лоб неможливо!",
 "SUBTITLE_BER2_IGD_047A_CHER": "^1ЧЕРНОВ: ^7Ми тримаємо його під вогнем!",
 "SUBTITLE_BER2_IGD_048A_REZN_A": "^1РЕЗНОВ: ^7Нагору!... Обійдіть їх згори!",
 "SUBTITLE_BER2_IGD_049A_REZN": "^1РЕЗНОВ: ^7Шукайте інший шлях!",
 "SUBTITLE_BER2_IGD_050A_REZN_A": "^1РЕЗНОВ: ^7Добра робота.",
 "SUBTITLE_BER2_IGD_051A_REZN_A": "^1РЕЗНОВ: ^7Пригніться. Дим може перехопити подих.",
